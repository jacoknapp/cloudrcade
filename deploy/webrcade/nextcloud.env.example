# Pass these to the CloudRcade container. The public URL is the site origin.
NEXTCLOUD_URL=https://cloud.example.com
WEBRCADE_PUBLIC_URL=https://arcade.example.com
NEXTCLOUD_ENABLED=true
NEXTCLOUD_AUTO_REDIRECT=false

# Optional: requires retroarcade_login installed and trusting this site's origin.
NEXTCLOUD_HANDOFF=false

# Optional: a trusted gateway must overwrite this header with verified access.
NEXTCLOUD_ACCESS_HEADER=
NEXTCLOUD_ACCESS_VALUE=

# Upgrade only: original server for older credentials/backups. New installs empty.
NEXTCLOUD_LEGACY_URL=
