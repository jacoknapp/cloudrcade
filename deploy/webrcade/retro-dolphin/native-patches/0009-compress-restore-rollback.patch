+// Copyright 2026 CloudRcade contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <span>
+#include <vector>
+
+namespace State
+{
+// Codec supplies Bound/Compress/Decompress with the LZ4 block contract.
+// A poorly compressible snapshot keeps the existing raw rollback path. During
+// compression, retained encoded blocks never exceed half the original snapshot.
+template <typename Codec, std::size_t BlockBytes = 4 * 1024 * 1024>
+class ChunkedRollbackBuffer
+{
+public:
+  bool TryStore(std::span<const unsigned char> raw)
+  {
+    Clear();
+    if (raw.empty())
+      return false;
+    const std::size_t budget = raw.size() / 2;
+    const int bound = Codec::Bound(static_cast<int>(std::min(BlockBytes, raw.size())));
+    if (bound <= 0)
+      return false;
+    std::vector<char> scratch(static_cast<std::size_t>(bound));
+    std::size_t stored = 0;
+    for (std::size_t offset = 0; offset < raw.size();)
+    {
+      const auto count = std::min(BlockBytes, raw.size() - offset);
+      const int encoded = Codec::Compress(reinterpret_cast<const char*>(raw.data() + offset),
+                                          scratch.data(), static_cast<int>(count), bound);
+      if (encoded <= 0 || encoded > bound || static_cast<std::size_t>(encoded) > budget - stored)
+      {
+        Clear();
+        return false;
+      }
+      m_chunks.emplace_back(scratch.data(), scratch.data() + encoded);
+      stored += static_cast<std::size_t>(encoded);
+      offset += count;
+    }
+    m_raw_size = raw.size();
+    return true;
+  }
+
+  bool Restore(std::span<unsigned char> output) const
+  {
+    if (Empty() || output.size() != m_raw_size)
+      return false;
+    std::size_t offset = 0;
+    for (const auto& chunk : m_chunks)
+    {
+      const auto count = std::min(BlockBytes, output.size() - offset);
+      const int decoded = Codec::Decompress(chunk.data(),
+          reinterpret_cast<char*>(output.data() + offset), static_cast<int>(chunk.size()),
+          static_cast<int>(count));
+      if (decoded != static_cast<int>(count))
+        return false;
+      offset += count;
+    }
+    return offset == output.size();
+  }
+
+  std::size_t RawSize() const { return m_raw_size; }
+  bool Empty() const { return m_raw_size == 0; }
+  void Clear()
+  {
+    m_chunks.clear();
+    m_raw_size = 0;
+  }
+
+private:
+  std::vector<std::vector<char>> m_chunks;
+  std::size_t m_raw_size = 0;
+};
+}  // namespace State
