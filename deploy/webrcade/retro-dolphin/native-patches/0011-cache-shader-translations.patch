+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <initializer_list>
+#include <memory>
+#include <new>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace WebGPU
+{
+// Process-local successful translation outputs only. The owner may seed this
+// from verified same-build records; no GPU handles or failures are retained.
+// The owner serializes access. Returned strings own their bytes, so eviction
+// cannot invalidate a shader or a command-ring payload already being emitted.
+class ShaderTranslationCache
+{
+public:
+  struct Key
+  {
+    std::uint32_t stage;
+    std::uint32_t variant;
+    std::string_view configuration;
+    std::string_view source;
+  };
+  struct Stats
+  {
+    std::uint64_t hits = 0;
+    std::uint64_t misses = 0;
+    std::uint64_t evictions = 0;
+    std::uint64_t rejected = 0;
+    std::uint64_t allocation_failures = 0;
+    std::uint64_t failures = 0;
+    std::uint64_t translation_microseconds = 0;
+    std::size_t entries = 0;
+    std::size_t bytes = 0;
+  };
+
+  // Bound retained UTF-8 inputs/outputs; the entry bound separately limits
+  // entry metadata. Temporary compiler allocations are not cache bytes.
+  explicit ShaderTranslationCache(std::size_t max_entries = 256,
+                                  std::size_t max_bytes = 8 * 1024 * 1024)
+      : m_max_entries(max_entries), m_max_bytes(max_bytes)
+  {
+  }
+
+  ~ShaderTranslationCache()
+  {
+    while (m_oldest)
+      RemoveOldest();
+  }
+  ShaderTranslationCache(const ShaderTranslationCache&) = delete;
+  ShaderTranslationCache& operator=(const ShaderTranslationCache&) = delete;
+
+  std::optional<std::string> Find(const Key& key)
+  {
+    const auto hash = Hash(key);
+    for (auto* entry = m_newest; entry; entry = entry->older)
+    {
+      // The hash is only a filter: exact bytes and every discriminator must
+      // match, including embedded NULs and colliding hashes.
+      if (Matches(*entry, key, hash))
+      {
+        ++m_stats.hits;
+        std::string result(entry->Wgsl());
+        Promote(entry);
+        return result;
+      }
+    }
+    ++m_stats.misses;
+    return std::nullopt;
+  }
+
+  bool Store(const Key& key, std::string_view wgsl)
+  {
+    // Subtract before adding so a hostile/oversized length cannot wrap the
+    // budget. Empty outputs are never useful successful translations.
+    std::size_t bytes = 0;
+    for (const auto size : {key.configuration.size(), key.source.size(), wgsl.size()})
+    {
+      if (size > m_max_bytes - bytes)
+      {
+        ++m_stats.rejected;
+        return false;
+      }
+      bytes += size;
+    }
+    if (wgsl.empty() || m_max_entries == 0)
+    {
+      ++m_stats.rejected;
+      return false;
+    }
+
+    const auto hash = Hash(key);
+    for (auto* entry = m_newest; entry; entry = entry->older)
+    {
+      // A racing compiler may have published the same key since its lookup.
+      if (Matches(*entry, key, hash))
+      {
+        Promote(entry);
+        return true;
+      }
+    }
+    // Dolphin disables C++ exceptions. Explicit nonthrowing requests preserve
+    // the valid compiler result when the allocator returns null; the SDK's
+    // existing fixed-heap abort-on-exhaustion policy is unchanged. Prepare all
+    // owned bytes before eviction so a failed request leaves old entries intact.
+    std::unique_ptr<Entry> entry(new (std::nothrow) Entry);
+    if (entry)
+      entry->data = static_cast<char*>(std::malloc(bytes));
+    if (!entry || !entry->data)
+    {
+      ++m_stats.allocation_failures;
+      return false;
+    }
+    entry->hash = hash;
+    entry->stage = key.stage;
+    entry->variant = key.variant;
+    entry->configuration_size = key.configuration.size();
+    entry->source_size = key.source.size();
+    entry->wgsl_size = wgsl.size();
+    if (!key.configuration.empty())
+      std::memcpy(entry->data, key.configuration.data(), key.configuration.size());
+    if (!key.source.empty())
+      std::memcpy(entry->data + key.configuration.size(), key.source.data(), key.source.size());
+    std::memcpy(entry->data + key.configuration.size() + key.source.size(), wgsl.data(), wgsl.size());
+    while (m_oldest &&
+           (m_stats.entries >= m_max_entries || bytes > m_max_bytes - m_stats.bytes))
+    {
+      RemoveOldest();
+      ++m_stats.evictions;
+    }
+    auto* published = entry.release();
+    published->older = m_newest;
+    if (m_newest)
+      m_newest->newer = published;
+    else
+      m_oldest = published;
+    m_newest = published;
+    m_stats.bytes += bytes;
+    ++m_stats.entries;
+    ++m_revision;
+    return true;
+  }
+
+  Stats GetStats() const { return m_stats; }
+  std::uint32_t Revision() const { return m_revision; }
+
+  template <typename Visitor>
+  void Visit(Visitor&& visitor) const
+  {
+    // Oldest first: replaying records preserves their bounded LRU order.
+    for (auto* entry = m_oldest; entry; entry = entry->newer)
+      visitor(Key{entry->stage, entry->variant, entry->Configuration(), entry->Source()},
+              entry->Wgsl());
+  }
+
+  void RecordTranslation(bool succeeded, std::uint64_t microseconds)
+  {
+    m_stats.failures += succeeded ? 0 : 1;
+    m_stats.translation_microseconds += microseconds;
+  }
+
+private:
+  struct Entry
+  {
+    Entry* older = nullptr;
+    Entry* newer = nullptr;
+    std::uint64_t hash = 0;
+    std::uint32_t stage = 0;
+    std::uint32_t variant = 0;
+    std::size_t configuration_size = 0;
+    std::size_t source_size = 0;
+    std::size_t wgsl_size = 0;
+    char* data = nullptr;
+    ~Entry() { std::free(data); }
+    std::string_view Configuration() const { return {data, configuration_size}; }
+    std::string_view Source() const { return {data + configuration_size, source_size}; }
+    std::string_view Wgsl() const { return {data + configuration_size + source_size, wgsl_size}; }
+    std::size_t Bytes() const { return configuration_size + source_size + wgsl_size; }
+  };
+
+  static bool Matches(const Entry& entry, const Key& key, std::uint64_t hash)
+  {
+    return entry.hash == hash && entry.stage == key.stage && entry.variant == key.variant &&
+           entry.Configuration() == key.configuration && entry.Source() == key.source;
+  }
+
+  void Promote(Entry* entry)
+  {
+    if (entry == m_newest)
+      return;
+    if (entry->older)
+      entry->older->newer = entry->newer;
+    else
+      m_oldest = entry->newer;
+    entry->newer->older = entry->older;
+    entry->older = m_newest;
+    entry->newer = nullptr;
+    m_newest->newer = entry;
+    m_newest = entry;
+  }
+
+  void RemoveOldest()
+  {
+    auto* removed = m_oldest;
+    m_oldest = removed->newer;
+    if (m_oldest)
+      m_oldest->older = nullptr;
+    else
+      m_newest = nullptr;
+    m_stats.bytes -= removed->Bytes();
+    --m_stats.entries;
+    delete removed;
+  }
+
+  static std::uint64_t Hash(const Key& key)
+  {
+    std::uint64_t hash = 14695981039346656037ull;
+    // Exact equality above disambiguates concatenations as well as collisions.
+    for (const auto text : {key.configuration, key.source})
+      for (const unsigned char byte : text)
+        hash = (hash ^ byte) * 1099511628211ull;
+    return hash;
+  }
+
+  const std::size_t m_max_entries;
+  const std::size_t m_max_bytes;
+  Entry* m_newest = nullptr;
+  Entry* m_oldest = nullptr;
+  Stats m_stats;
+  std::uint32_t m_revision = 0;
+};
+}  // namespace WebGPU
