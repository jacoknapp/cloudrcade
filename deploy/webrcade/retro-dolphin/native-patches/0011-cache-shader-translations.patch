   return wgsl;
 }
+
+std::optional<std::string> GlslToWgsl(ShaderStage stage, std::string_view glsl,
+                                    ShaderTranslationVariant variant)
+{
+  const ShaderTranslationCache::Key key{static_cast<u32>(stage), static_cast<u32>(variant),
+                                        kShaderHeader, glsl};
+  // Never hold the cache lock across either compiler, diagnostics or ring work.
+  // Concurrent misses may compile twice; neither thread can publish partial data.
+  {
+    std::lock_guard<std::mutex> guard(s_translation_cache_mutex);
+    if (auto result = s_translation_cache.Find(key))
+      return result;
+  }
+  const auto start = std::chrono::steady_clock::now();
+  auto result = TranslateGlslToWgsl(stage, glsl);
+  const auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(
+      std::chrono::steady_clock::now() - start).count();
+  {
+    std::lock_guard<std::mutex> guard(s_translation_cache_mutex);
+    s_translation_cache.RecordTranslation(result.has_value(), static_cast<std::uint64_t>(elapsed));
+    if (result)
+      s_translation_cache.Store(key, *result);
+  }
+  return result;
+}
+
+ShaderTranslationCache::Stats GetShaderTranslationCacheStats()
+{
+  std::lock_guard<std::mutex> guard(s_translation_cache_mutex);
+  return s_translation_cache.GetStats();
+}
+
+// Only verified per-build host records reach this API. The exact header is
+// supplied by this binary and exact GLSL is still checked on demand. No GPU
+// objects are restored, no pipelines are precompiled, and shader failures are
+// never persisted. These cache APIs do not change the save-state format.
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_ShaderTranslationRevision()
+{
+  std::lock_guard<std::mutex> guard(s_translation_cache_mutex);
+  return s_translation_cache.Revision();
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_GetShaderTranslationStats()
+{
+  std::lock_guard<std::mutex> guard(s_translation_cache_mutex);
+  const auto stats = s_translation_cache.GetStats();
+  EM_ASM({ Module._cloudrcadeShaderCacheStats = ({
+      hits: $0, translations: $1, failures: $2, translationMs: $3,
+      entries: $4, retainedBytes: $5, evictions: $6, rejected: $7, allocationFailures: $8}); },
+    static_cast<double>(stats.hits), static_cast<double>(stats.misses),
+    static_cast<double>(stats.failures), static_cast<double>(stats.translation_microseconds) / 1000.0,
+    stats.entries, stats.bytes, static_cast<double>(stats.evictions),
+    static_cast<double>(stats.rejected), static_cast<double>(stats.allocation_failures));
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE bool DolphinWeb_ImportShaderTranslation(
+    u32 stage, u32 variant, const char* source, u32 source_size, const char* wgsl, u32 wgsl_size)
+{
+  if (stage > static_cast<u32>(ShaderStage::Compute) || variant > 1 || !source || !wgsl ||
+      source_size > 8 * 1024 * 1024 || wgsl_size == 0 || wgsl_size > 8 * 1024 * 1024)
+    return false;
+  std::lock_guard<std::mutex> guard(s_translation_cache_mutex);
+  return s_translation_cache.Store({stage, variant, kShaderHeader, {source, source_size}},
+                                   {wgsl, wgsl_size});
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE void DolphinWeb_ExportShaderTranslations()
+{
+  std::lock_guard<std::mutex> guard(s_translation_cache_mutex);
+  EM_ASM({ Module._cloudrcadeShaderSnapshot = []; });
+  s_translation_cache.Visit([](const ShaderTranslationCache::Key& key, std::string_view wgsl) {
+    EM_ASM({ Module._cloudrcadeShaderSnapshot.push({stage: $0, variant: $1,
+               source: UTF8ToString($2, $3), wgsl: UTF8ToString($4, $5)}); },
+           key.stage, key.variant, key.source.data(), key.source.size(), wgsl.data(), wgsl.size());
+  });
+}
 }  // namespace WebGPU
