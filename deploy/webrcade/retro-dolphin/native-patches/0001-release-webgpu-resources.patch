+
+void WebGPUGfx::ReleaseRetiredBindGroups()
+{
+  // PushDestroy poisons an unpublished pass. Only call after ending/aborting it.
+  for (const u32 id : m_retired_bind_groups)
+    m_cmd_stream.PushDestroy(3, id);
+  m_retired_bind_groups.clear();
+}
+
+void WebGPUGfx::ReleaseTextureResource(u32 id)
+{
+  if (id == 0)
+    return;
+  EndPassIfOpen();
+  for (Bg1Slot& slot : m_bg1_cache)
+  {
+    if (slot.id != 0 && std::find(slot.texture_ids.begin(), slot.texture_ids.end(), id) !=
+                            slot.texture_ids.end())
+    {
+      m_cmd_stream.PushDestroy(3, slot.id);
+      slot = {};
+    }
+  }
+  for (u32& texture_id : m_tex_id)
+  {
+    if (texture_id == id)
+      texture_id = 0;
+  }
+  if (m_fb_color_id == id)
+    m_fb_color_id = 0;
+  if (m_fb_depth_id == id)
+    m_fb_depth_id = 0;
+  ResetRecordedPassState();
+  m_cmd_stream.PushDestroy(2, id);
 }
 
 
