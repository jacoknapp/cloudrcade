diff --git a/Source/Core/Core/PowerPC/CachedInterpreter/WasmInstanceClock.h b/Source/Core/Core/PowerPC/CachedInterpreter/WasmInstanceClock.h
new file mode 100644
--- /dev/null
+++ b/Source/Core/Core/PowerPC/CachedInterpreter/WasmInstanceClock.h
@@ -0,0 +1,99 @@
+// Copyright 2026 CloudRcade contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <algorithm>
+#include <cassert>
+#include <cstddef>
+#include <cstdint>
+#include <list>
+#include <unordered_map>
+#include <vector>
+
+// CPU-thread-only lifetime registry. Callback operands keep a stable pointer to
+// the reference byte; execution needs one store, with no JS call, clock or map.
+// Native invalidation drops users but never frees a possibly executing function.
+// Retire must run only after all compiled callbacks have returned.
+template <typename Block>
+class WasmInstanceClock
+{
+  struct Entry
+  {
+    int handle;
+    std::uint8_t referenced = 1;
+    std::vector<Block*> users;
+  };
+  using Entries = std::list<Entry>;
+  using Iterator = typename Entries::iterator;
+
+public:
+  WasmInstanceClock() = default;
+  WasmInstanceClock(const WasmInstanceClock&) = delete;
+  WasmInstanceClock& operator=(const WasmInstanceClock&) = delete;
+  WasmInstanceClock(WasmInstanceClock&&) = delete;
+  WasmInstanceClock& operator=(WasmInstanceClock&&) = delete;
+
+  std::uint8_t* Acquire(int handle, Block* block)
+  {
+    assert(!m_users.contains(block));
+    auto found = m_handles.find(handle);
+    if (found == m_handles.end())
+    {
+      auto entry = m_entries.insert(m_entries.end(), Entry{handle, 1, {}});
+      found = m_handles.emplace(handle, entry).first;
+    }
+    auto entry = found->second;
+    entry->referenced = 1;
+    entry->users.push_back(block);
+    m_users.emplace(block, entry);
+    return &entry->referenced;
+  }
+
+  void Release(Block* block)
+  {
+    const auto found = m_users.find(block);
+    if (found == m_users.end())
+      return;
+    auto& users = found->second->users;
+    users.erase(std::find(users.begin(), users.end(), block));
+    m_users.erase(found);
+  }
+
+  std::size_t Size() const { return m_entries.size(); }
+
+  template <typename Invalidate>
+  std::vector<int> Retire(std::size_t scan_budget, std::size_t retire_budget,
+                          Invalidate invalidate)
+  {
+    std::vector<int> retired;
+    // Never clear and then evict an entry in the same maintenance pass.
+    const auto scans = std::min(scan_budget, m_entries.size());
+    for (std::size_t i = 0; i < scans && retired.size() < retire_budget; ++i)
+    {
+      if (m_hand == m_entries.end())
+        m_hand = m_entries.begin();
+      const auto entry = m_hand++;
+      if (!entry->users.empty() && entry->referenced)
+      {
+        entry->referenced = 0;
+        continue;
+      }
+      while (!entry->users.empty())
+      {
+        Block* block = entry->users.back();
+        invalidate(block);  // Must unlink every native/static reference first.
+        assert(!m_users.contains(block));
+      }
+      retired.push_back(entry->handle);
+      m_handles.erase(entry->handle);
+      m_entries.erase(entry);
+    }
+    return retired;
+  }
+
+private:
+  Entries m_entries;
+  Iterator m_hand = m_entries.end();
+  std::unordered_map<int, Iterator> m_handles;
+  std::unordered_map<Block*, Iterator> m_users;
+};
