+void EmitWasmMemoryGroupProof(std::vector<u8>& body, const WasmStateLayout& layout,
+                              u32 base, s32 low, s32 high, bool fp = false, bool high_alias = false, u32 align_offset = 0)
+{
+  EmitStateLoadU32(body, GprOffset(layout, base)); EmitI32Const(body, static_cast<u32>(low));
+  body.push_back(0x6a); EmitI32Const(body, 0x3fffffff); body.push_back(0x71);
+  body.push_back(0x22); EmitU32Leb(body, 40);
+  EmitStateLoadU32(body, GprOffset(layout, base)); EmitI32Const(body, static_cast<u32>(high));
+  body.push_back(0x6a); EmitI32Const(body, 0x3fffffff); body.push_back(0x71);
+  body.push_back(0x22); EmitU32Leb(body, 3);
+  body.push_back(0x4d);  // unsigned low <= high, rejects masked-address wrap
+  EmitLocalGet(body, 3); EmitI32Const(body, layout.ram_size_real);
+  body.push_back(0x49); body.push_back(0x71);  // highest byte < RAM size
+  if (fp)
+  {
+    EmitStateLoadU32(body, layout.msr_offset); EmitI32Const(body, (1u << 13) | 1u);
+    body.push_back(0x71); EmitI32Const(body, 1u << 13); body.push_back(0x46); body.push_back(0x71);
+    EmitLocalGet(body, 40); EmitI32Const(body, align_offset); body.push_back(0x6a);
+    EmitI32Const(body, 3); body.push_back(0x71); body.push_back(0x45); body.push_back(0x71);
+    if (high_alias)
+    {
+      EmitStateLoadU32(body, GprOffset(layout, base)); EmitI32Const(body, static_cast<u32>(low)); body.push_back(0x6a);
+      EmitI32Const(body, 0x80000000u); body.push_back(0x71); EmitI32Const(body, 0);
+      body.push_back(0x47); body.push_back(0x71);
