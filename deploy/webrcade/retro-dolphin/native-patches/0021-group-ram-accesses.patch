+// Only consecutive integer/float memory ops; no helper/system/ALU may intervene.
+// A member which writes the base is included last, using its original value.
+std::size_t WasmMemoryGroupLength(std::span<const PPCAnalyst::CodeOp> ops)
+{
+  if (ops.empty()) return 0;
+  const u32 base = ops.front().inst.RA;
+  if (!base) return 0;
+  std::size_t count = 0;
+  s32 fp_offset = 0; bool have_fp = false;
+  for (const auto& op : ops)
+  {
+    const u32 code = op.inst.OPCD;
+    if (op.skip || !op.opinfo || code < 32 || code > 55 || code == 46 || code == 47 || op.inst.RA != base ||
+        !IsPpcWasmDirectInstructionCandidate(op))
+      break;
+    if (code >= 48)
+    {
+      const s32 off = op.inst.SIMM_16;
+      if (have_fp && ((off - fp_offset) & 3)) break;
+      fp_offset = off; have_fp = true;
+    }
+    ++count;
+    const bool load = code <= 35 || (code >= 40 && code <= 43);
+    if ((code & 1) || op.regsOut[base] || (load && op.inst.RD == base) || count == 8)
+      break;
+  }
+  return count >= 3 ? count : 0;
+}
+
+u32 WasmMemoryAccessSize(u32 opcode)
+{
+  if (opcode >= 48) return opcode == 50 || opcode == 51 || opcode == 54 || opcode == 55 ? 8u : 4u;
+  return opcode <= 33 || opcode == 36 || opcode == 37 ? 4u : opcode >= 40 ? 2u : 1u;
+}
