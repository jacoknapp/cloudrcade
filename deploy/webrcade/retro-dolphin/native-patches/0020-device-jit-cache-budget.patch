+// Selected before boot, then sealed before allocating callback operands. The
+// shared atomic lets the actual compiling pthread configure its own JS table.
+constexpr u32 DEFAULT_WASM_INSTANCE_CAPACITY = 16384;
+constexpr u32 WASM_INSTANCE_BUDGET_LOCKED = 1u << 31;
+std::atomic<u32> s_wasm_instance_capacity{DEFAULT_WASM_INSTANCE_CAPACITY};
+extern "C" EMSCRIPTEN_KEEPALIVE int DolphinWeb_SetWasmCacheProfile(int desktop)
+{
+  if (desktop != 0 && desktop != 1)
+    return 0;
+  const u32 capacity = desktop ? 32768u : DEFAULT_WASM_INSTANCE_CAPACITY;
+  u32 previous = s_wasm_instance_capacity.load(std::memory_order_relaxed);
+  while (!(previous & WASM_INSTANCE_BUDGET_LOCKED))
+  {
+    if (s_wasm_instance_capacity.compare_exchange_weak(previous, capacity,
+                                                      std::memory_order_relaxed))
+      return 1;
+  }
+  return 0;
+}
+extern "C" EMSCRIPTEN_KEEPALIVE u32 DolphinWeb_GetWasmCacheCapacity()
+{
+  return s_wasm_instance_capacity.load(std::memory_order_relaxed) & ~WASM_INSTANCE_BUDGET_LOCKED;
+}
