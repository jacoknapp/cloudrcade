+inline void AddSliceTotal(std::atomic<std::uint64_t>& field, std::uint64_t value)
+{
+  const std::uint64_t old = field.load(std::memory_order_relaxed);
+  const std::uint64_t max = std::numeric_limits<std::uint64_t>::max();
+  field.store(value > max - old ? max : old + value, std::memory_order_relaxed);
+}
