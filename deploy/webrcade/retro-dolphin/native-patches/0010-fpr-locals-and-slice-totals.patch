+inline void RecordSliceTotals(std::uint32_t total_us, std::uint32_t advance_us,
+                              std::uint32_t execute_us, const CurrentSlice& slice)
+{
+  advance_us = std::min(advance_us, total_us);
+  execute_us = std::min(execute_us, total_us);
+  s_slice_totals.sequence.fetch_add(1, std::memory_order_acq_rel);
+  std::atomic_thread_fence(std::memory_order_release);
+  AddSliceTotal(s_slice_totals.slices, 1);
+  AddSliceTotal(s_slice_totals.total_us, total_us);
+  AddSliceTotal(s_slice_totals.advance_inclusive_us, std::min(advance_us, total_us));
+  AddSliceTotal(s_slice_totals.execute_inclusive_us, std::min(execute_us, total_us));
+  AddSliceTotal(s_slice_totals.compile_subset_us, std::min(slice.compile_us, execute_us));
+  AddSliceTotal(s_slice_totals.throttle_blocked_subset_us,
+                std::min(slice.throttle_wait_us, advance_us));
+  AddSliceTotal(s_slice_totals.dvd_blocked_subset_us, std::min(slice.dvd_wait_us, advance_us));
+  s_slice_totals.sequence.fetch_add(1, std::memory_order_release);
