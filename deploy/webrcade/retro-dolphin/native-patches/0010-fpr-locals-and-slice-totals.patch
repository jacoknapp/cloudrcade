+    snapshot.slices = s_slice_totals.slices.load(std::memory_order_relaxed);
+    snapshot.total_us = s_slice_totals.total_us.load(std::memory_order_relaxed);
+    snapshot.advance_inclusive_us = s_slice_totals.advance_inclusive_us.load(std::memory_order_relaxed);
+    snapshot.execute_inclusive_us = s_slice_totals.execute_inclusive_us.load(std::memory_order_relaxed);
+    snapshot.compile_subset_us = s_slice_totals.compile_subset_us.load(std::memory_order_relaxed);
+    snapshot.throttle_blocked_subset_us =
