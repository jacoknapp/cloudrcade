+// Account exact lanes touched by the existing emitters, rather than relying
+// on analyst liveness (test ops and interpreted prefixes can omit it).
+bool CountFprCacheLaneUses(UGeckoInstruction inst, std::array<u32, 64>& uses)
+{
+  if (inst.Rc)
+    return false;
+  const auto use = [&](u32 reg, u32 lane) { ++uses[reg * 2 + lane]; };
+  if (inst.OPCD == 4 && IsPairedSingleMergeSubop(inst.SUBOP10))
+  {
+    use(inst.FA, inst.SUBOP10 >= 592 ? 1 : 0);
+    use(inst.FB, inst.SUBOP10 == 560 || inst.SUBOP10 == 624 ? 1 : 0);
+    use(inst.FD, 0);
+    use(inst.FD, 1);
+    return true;
+  }
+  if (inst.OPCD == 63 && (inst.SUBOP10 == 72 || inst.SUBOP10 == 12))
+  {
+    use(inst.FB, 0);
+    use(inst.FD, 0);
+    if (inst.SUBOP10 == 12)
+      use(inst.FD, 1);
+    return true;
+  }
+  const bool paired = inst.OPCD == 4 && IsPairedSingleArithmeticSubop(inst.SUBOP5);
+  const bool single = inst.OPCD == 59 && IsSinglePrecisionArithmeticSubop(inst.SUBOP5);
+  const bool dual = inst.OPCD == 63 && IsDoublePrecisionArithmeticSubop(inst.SUBOP5);
+  if (!paired && !single && !dual)
+    return false;
+  for (u32 lane = 0; lane < (paired ? 2u : 1u); ++lane)
+  {
+    use(inst.FA, lane);
+    const bool scalar = paired && inst.SUBOP5 >= 12 && inst.SUBOP5 <= 15;
+    if (scalar || inst.SUBOP5 == 25 || inst.SUBOP5 >= 28)
+      use(inst.FC, scalar ? (inst.SUBOP5 == 13 || inst.SUBOP5 == 15 ? 1 : 0) : lane);
+    if (inst.SUBOP5 != 25 && (!scalar || inst.SUBOP5 >= 14))
+      use(inst.FB, lane);
+    use(inst.FD, lane);
+  }
+  if (single)
+    use(inst.FD, 1);
+  return true;
+}
