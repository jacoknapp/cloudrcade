+// A run needs repeated uses to repay its eager loads. Only repeated lanes are
+// cached; untouched/single-use lanes retain the original memory emission.
+std::size_t BeginFprCacheRun(std::vector<u8>& body, const WasmStateLayout& layout,
+                            std::span<const PPCAnalyst::CodeOp> ops)
+{
+  s_fpr_rc = {};
+  if (DolphinWebHelperDisabled(DOLPHIN_WEB_DISABLE_REGALLOC))
+    return 0;
+  std::array<u32, 64> uses{};
+  std::size_t count = 0;
+  for (const auto& op : ops)
+  {
+    if (op.skip || !CountFprCacheLaneUses(op.inst, uses))
+      break;
+    ++count;
+  }
+  if (count < 4)
+    return 0;
+  s_fpr_rc.active = true;
+  s_fpr_rc.ps_base = layout.ps_offset;
+  for (u32 i = 0; i < 64; ++i)
+    s_fpr_rc.present[i] = uses[i] >= 2;
+  EmitFprCacheReloadAll(body);
+  return count;
+}
