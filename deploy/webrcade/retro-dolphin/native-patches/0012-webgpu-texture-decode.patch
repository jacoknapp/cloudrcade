+bool WebGPUTexture::LoadEncoded(u32 level, u32 width, u32 height, u32 aligned_width,
+                                u32 aligned_height, const u8* data, u32 data_size,
+                                TextureFormat format, const u8* palette, TLUTFormat palette_format)
+{
+  if ((DolphinWeb_GetRendererFeatureMask() & 2u) == 0 || g_ActiveConfig.bArbitraryMipmapDetection ||
+      g_ActiveConfig.bTexFmtOverlayEnable || g_ActiveConfig.bDumpTextures ||
+      !IsValidTextureFormat(format) || !data || !g_gfx || level >= m_config.levels ||
+      m_config.format != AbstractTextureFormat::RGBA8 || m_config.samples != 1 ||
+      m_config.layers != 1 || width != std::max(m_config.width >> level, 1u) ||
+      height != std::max(m_config.height >> level, 1u) || width > 1024 || height > 1024)
+    return false;
+  const u32 block_width = TexDecoder_GetBlockWidthInTexels(format);
+  const u32 block_height = TexDecoder_GetBlockHeightInTexels(format);
+  if (aligned_width != (width + block_width - 1) / block_width * block_width ||
+      aligned_height != (height + block_height - 1) / block_height * block_height ||
+      data_size != static_cast<u32>(TexDecoder_GetTextureSizeInBytes(aligned_width, aligned_height, format)))
+    return false;
+  const u32 palette_size = TexDecoder_GetPaletteSize(format);
+  if (palette_size && (!palette || static_cast<u32>(palette_format) > 2))
+    return false;
+  const u32 id = EnsureBridgeId();
+  if (!id)
+    return false;
+
+  // Snapshot both for replay and a lazily materialized exact CPU mirror. Cache hashing,
+  // RAM/TMEM invalidation and palette identity remain owned by TextureCacheBase.
+  EncodedMip shadow;
+  shadow.data.assign(data, data + data_size);
+  if (palette_size)
+    shadow.palette.assign(palette, palette + palette_size);
+  shadow.format = format;
+  shadow.palette_format = palette_format;
+  shadow.width = aligned_width;
+  shadow.height = aligned_height;
+  // Header is little-endian u32; encoded source/palette bytes retain GX byte order.
+  std::vector<u32> packet(4 + (data_size + palette_size) / 4);
+  packet[0] = static_cast<u32>(format);
+  packet[1] = static_cast<u32>(palette_format);
+  packet[2] = data_size;
+  packet[3] = palette_size;
+  std::memcpy(packet.data() + 4, shadow.data.data(), data_size);
+  if (palette_size)
+    std::memcpy(reinterpret_cast<u8*>(packet.data() + 4) + data_size,
+                shadow.palette.data(), palette_size);
+  static_cast<WebGPUGfx*>(g_gfx.get())->PrepareTextureDecode();
+  auto& cs = GetCommandStream();
+  const u32 bytes = static_cast<u32>(packet.size() * sizeof(u32));
+  const u32 src = cs.UploadAlloc(packet.data(), bytes, 4);
+  if (!src || !cs.PushDecodeTexture(id, src, bytes, width, height, level, aligned_width))
+    return false;
+  m_encoded[level] = std::move(shadow);
+  return true;
+}
+
+void WebGPUTexture::MaterializeShadow(u32 layer, u32 level) const
+{
+  if (layer != 0 || m_encoded[level].data.empty())
+    return;
+  auto& shadow = m_encoded[level];
+  std::vector<u8> decoded(static_cast<size_t>(shadow.width) * shadow.height * 4);
+  TexDecoder_Decode(decoded.data(), shadow.data.data(), shadow.width, shadow.height,
+                   shadow.format, shadow.palette.data(), shadow.palette_format);
+  const u32 width = std::max(m_config.width >> level, 1u);
+  const u32 height = std::max(m_config.height >> level, 1u);
+  for (u32 y = 0; y < height; ++y)
+    std::memcpy(m_data[layer][level].data() + static_cast<size_t>(y) * width * 4,
+                decoded.data() + static_cast<size_t>(y) * shadow.width * 4, width * 4);
+  shadow = {};
+}
+
 const u8* WebGPUTexture::GetData(u32 layer, u32 level) const
 {
+  MaterializeShadow(layer, level);
   return m_data[layer][level].data();
 }

 u8* WebGPUTexture::GetData(u32 layer, u32 level)
 {
+  MaterializeShadow(layer, level);
   return m_data[layer][level].data();
 }

