+  rec.arg.u[0] = id;
+  rec.arg.u[1] = src_heap_ptr;
+  rec.arg.u[2] = bytes;
+  rec.arg.u[3] = w;
+  rec.arg.u[4] = h;
+  rec.arg.u[5] = mip_level;
+  rec.arg.u[6] = aligned_width;
+  if (!Push(rec))
+  {
+    RollbackLastUpload(src_heap_ptr, bytes);
+    return false;
+  }
+  return true;
