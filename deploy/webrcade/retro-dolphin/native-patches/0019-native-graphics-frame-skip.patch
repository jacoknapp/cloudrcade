+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <atomic>
+#include <cstdint>
+
+namespace DolphinWeb::FrameSkip
+{
+// Only the GPU thread owns cadence. The host publishes a request; it takes
+// effect after a complete XFB frame, never halfway through its draw batches.
+inline std::atomic<unsigned> requested{1};
+inline unsigned divisor = 1, phase = 0;
+inline bool current_skip = false, needs_latch = true;
+inline std::atomic<std::uint32_t> frames{0}, skipped_frames{0};
+inline std::atomic<std::uint32_t> drawn_batches{0}, skipped_batches{0};
+inline std::atomic<std::uint32_t> cpu_efb_accesses{0};
+inline std::atomic<std::uint64_t> decoded_vertices{0}, skipped_vertices{0};
+inline std::atomic<std::uint32_t> ram_efb_copies{0}, skipped_efb_copies{0};
+inline std::atomic<std::uint32_t> skipped_no_pass{0};
+// A VI swap may happen while the guest is already drawing its next image.
+// Keep that image's decision until its XFB copy; new work latches pending phase.
+inline bool Skip() { return current_skip; }
+inline void BeginDraw()
+{
+  if (needs_latch) { current_skip = phase != 0; needs_latch = false; }
+}
+inline void XfbCopied() { needs_latch = true; }
+inline void EndFrame(bool skipped)
+{
+  frames.fetch_add(1, std::memory_order_relaxed);
+  if (skipped) skipped_frames.fetch_add(1, std::memory_order_relaxed);
+  const unsigned next = requested.load(std::memory_order_relaxed);
+  phase = next == divisor ? (phase + 1) % divisor : 0;
+  divisor = next;
+}
+inline void ResetPhase()
+{
+  phase = 0; divisor = requested.load(std::memory_order_relaxed);
+  current_skip = false; needs_latch = true;
+}
+inline void Batch(bool skip)
+{
+  (skip ? skipped_batches : drawn_batches).fetch_add(1, std::memory_order_relaxed);
+}
+}  // namespace DolphinWeb::FrameSkip
