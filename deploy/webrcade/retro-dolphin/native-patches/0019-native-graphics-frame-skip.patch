+// Compare the real portable loader's retained GX state with full conversion.
+// May only run before a video backend has initialized; never mutates gameplay.
+extern "C" EMSCRIPTEN_KEEPALIVE int RunGraphicsFrameSkipVertexSmoke()
+{
+  using namespace VertexLoaderManager;
+  if (g_vertex_manager) return -1;
+  const auto original_phase = DolphinWeb::FrameSkip::phase;
+  const auto original_current_skip = DolphinWeb::FrameSkip::current_skip;
+  const auto original_needs_latch = DolphinWeb::FrameSkip::needs_latch;
+  const auto original_decoded = DolphinWeb::FrameSkip::decoded_vertices.load();
+  const auto original_skipped = DolphinWeb::FrameSkip::skipped_vertices.load();
+  const auto original_bases = cached_arraybases;
+  const auto original_stride = g_main_cp_state.array_strides[CPArray::Position];
+  const auto original_read = g_video_buffer_read_ptr;
+  const auto original_write = g_vertex_manager_write_ptr;
+  auto snapshot = [] { return std::tuple{position_cache, position_matrix_index_cache,
+                                        normal_cache, tangent_cache, binormal_cache}; };
+  auto restore = [](const auto& v) {
+    std::tie(position_cache, position_matrix_index_cache, normal_cache, tangent_cache,
+             binormal_cache) = v;
+  };
+  const auto original_caches = snapshot();
+  std::vector<u8> positions(65536 * 12, 0);
+  auto append_float = [](std::vector<u8>& bytes, float value) {
+    const u32 swapped = Common::swap32(std::bit_cast<u32>(value));
+    const auto* p = reinterpret_cast<const u8*>(&swapped);
+    bytes.insert(bytes.end(), p, p + 4);
+  };
+  for (unsigned i = 0; i < 12; ++i)
+  {
+    std::vector<u8> v;
+    for (unsigned j = 0; j < 3; ++j) append_float(v, i * 10.f + j + 0.5f);
+    std::copy(v.begin(), v.end(), positions.begin() + i * 12);
+  }
+  cached_arraybases[CPArray::Position] = positions.data();
+  g_main_cp_state.array_strides[CPArray::Position] = 12;
+  int result = 1, case_id = 0;
+  for (const auto format : {VertexComponentFormat::Direct, VertexComponentFormat::Index8,
+                            VertexComponentFormat::Index16})
+  for (const bool normals : {false, true})
+  for (const bool sentinel : {false, true})
+  {
+    ++case_id;
+    TVtxDesc desc{};
+    VAT vat{};
+    desc.low.PosMatIdx = true;
+    desc.low.Tex3MatIdx = true;
+    desc.low.Position = format;
+    desc.low.Normal = normals ? VertexComponentFormat::Direct : VertexComponentFormat::NotPresent;
+    vat.g0.PosFormat = ComponentFormat::Float;
+    vat.g0.PosElements = CoordComponentCount::XYZ;
+    vat.g0.NormalFormat = ComponentFormat::Float;
+    vat.g0.NormalElements = NormalComponentCount::NTB;
+    VertexLoader loader(desc, vat);
+    std::vector<u8> input;
+    for (unsigned i = 0; i < 9; ++i)
+    {
+      input.push_back((i * 3) & 63);
+      input.push_back((i * 7) & 63);
+      if (format == VertexComponentFormat::Direct)
+        for (unsigned j = 0; j < 3; ++j) append_float(input, i * 10.f + j + 0.5f);
+      else
+      {
+        const unsigned index = sentinel && i == 8 ? 65535 : i;
+        if (format == VertexComponentFormat::Index16) input.push_back(index >> 8);
+        input.push_back(index & 255);
+      }
+      if (normals)
+        for (unsigned j = 0; j < 9; ++j) append_float(input, i * 100.f + j + 0.25f);
+    }
+    std::array<u8, 4096> full{}, tail{};
+    restore(original_caches);
+    DolphinWeb::FrameSkip::phase = 0;
+    DolphinWeb::FrameSkip::current_skip = false;
+    const int full_count = loader.RunVertices(input.data(), full.data(), 9);
+    const auto expected = snapshot();
+    restore(original_caches);
+    DolphinWeb::FrameSkip::phase = 1;
+    DolphinWeb::FrameSkip::current_skip = true;
+    const int tail_count = loader.RunVertices(input.data(), tail.data(), 9);
+    const bool fallback = sentinel && format != VertexComponentFormat::Direct;
+    if (snapshot() != expected || tail_count != (fallback ? full_count : 3) ||
+        (!fallback && std::memcmp(tail.data(), full.data() + 6 * loader.m_native_vtx_decl.stride,
+                                  3 * loader.m_native_vtx_decl.stride) != 0))
+      result = -case_id - 1;
+  }
+  restore(original_caches);
+  cached_arraybases = original_bases;
+  g_main_cp_state.array_strides[CPArray::Position] = original_stride;
+  g_video_buffer_read_ptr = original_read;
+  g_vertex_manager_write_ptr = original_write;
+  DolphinWeb::FrameSkip::phase = original_phase;
+  DolphinWeb::FrameSkip::current_skip = original_current_skip;
+  DolphinWeb::FrameSkip::needs_latch = original_needs_latch;
+  DolphinWeb::FrameSkip::decoded_vertices.store(original_decoded);
+  DolphinWeb::FrameSkip::skipped_vertices.store(original_skipped);
+  return result;
+}
