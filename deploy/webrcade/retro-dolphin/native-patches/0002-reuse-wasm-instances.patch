diff --git a/Source/Core/Core/PowerPC/CachedInterpreter/WasmInstanceCache.js b/Source/Core/Core/PowerPC/CachedInterpreter/WasmInstanceCache.js
new file mode 100644
--- /dev/null
+++ b/Source/Core/Core/PowerPC/CachedInterpreter/WasmInstanceCache.js
@@ -0,0 +1,28 @@
+// Copyright 2026 CloudRcade contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+// The cache belongs to this Emscripten worker's memory and function table.
+// Exact generated bytes and helper bindings identify an immutable function.
+(() => {
+  const entries = new Map();
+  const capacity = 32768;
+  const key = (identity, bindings) => [identity, ...bindings].join('|');
+  Module._dolphinWasmInstances = {
+    get: (identity, bindings) => entries.get(key(identity, bindings)),
+    full: () => entries.size >= capacity,
+    insert(identity, bindings, fn) {
+      const signature = key(identity, bindings);
+      const existing = entries.get(signature);
+      if (existing !== undefined) return existing;
+      if (entries.size >= capacity) return 0;
+      const handle = wasmTable.length;
+      try { wasmTable.grow(1); }
+      catch (error) {
+        if (error?.name === 'RangeError') return 0;
+        throw error;
+      }
+      wasmTable.set(handle, fn);
+      entries.set(signature, handle);
+      return handle;
+    },
+  };
+})();
