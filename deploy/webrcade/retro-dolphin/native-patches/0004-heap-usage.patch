+// SPDX-License-Identifier: GPL-2.0-or-later
+// Snapshot only when polled by the host, outside the CPU/GPU hot paths.
+#include <array>
+#include <cstdint>
+#include <malloc.h>
+#include <unistd.h>
+#include <emscripten/heap.h>
+
+extern "C" std::uint32_t* GetHeapStats()
+{
+  thread_local std::array<std::uint32_t, 4> snapshot{};
+  const auto allocator = mallinfo();
+  snapshot = {static_cast<std::uint32_t>(allocator.uordblks),
+              static_cast<std::uint32_t>(allocator.fordblks),
+              static_cast<std::uint32_t>(reinterpret_cast<std::uintptr_t>(sbrk(0))),
+              static_cast<std::uint32_t>(emscripten_get_heap_size())};
+  return snapshot.data();
+}
