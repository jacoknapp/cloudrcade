+// A separate, small loop for full compiled blocks. Preserve exact instruction
+// state/timing and CLOCK stores; avoid the legacy callback switch and per-block
+// TLS completion publication. Capture operand scalars before the call because
+// a helper can invalidate the source's callback storage.
+__attribute__((noinline)) bool CachedInterpreter::ExecuteWasmFastChain(
+    const u8* entry, bool allow_dispatch)
+{
+  const auto full = [](const u8* candidate) {
+    return candidate && *reinterpret_cast<const AnyCallback*>(candidate) == AnyCallbackCast(RunWasmBlock) &&
+        reinterpret_cast<const WasmBlockOperands*>(candidate + sizeof(AnyCallback))->end_block == 1;
+  };
+  if (!full(entry)) return false;
+  struct Counts
+  {
+    u32 blocks = 0;
+    ~Counts() { s_wasm_fast_chain_blocks.fetch_add(blocks, std::memory_order_relaxed); }
+  } counts;
+  // Shield any enclosing/nested legacy callback scope. We resolve the actual
+  // completed full block's descriptor directly and never dereference TLS data.
+  StaticExitLinks::Scope boundary(&m_block_cache, &m_ppc_state, false);
+  auto& state = m_ppc_state;
+  const CPU::State* const cpu_state = m_system.GetCPU().GetStatePtr();
+  const bool links_enabled = StaticExitLinksEnabled();
+  using WasmFunction = int (*)(int);
+  do
+  {
+    const auto* const op = reinterpret_cast<const WasmBlockOperands*>(entry + sizeof(AnyCallback));
+    const u64 source_epoch = m_block_cache.StaticLinkEpoch();
+    const u32 source_features = static_cast<u32>(state.feature_flags);
+    const auto* const links = &op->links;
+    const int handle = op->handle;
+    const u32 cycles = op->downcount, loads = op->num_load_stores, fp = op->num_fp_inst;
