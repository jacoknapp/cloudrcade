+      next = m_block_cache.Dispatch();
+      if (!next)
+      {
+        boundary.Close();  // no cached callback active at this code-generation safe point
+        Jit(state.pc);
+        return true;
+      }
+    }
+    entry = next;
+  } while (full(entry));
