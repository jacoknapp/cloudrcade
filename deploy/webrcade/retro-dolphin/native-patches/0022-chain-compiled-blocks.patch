+    ++s_wasm_block_run_count;
+    *op->referenced = 1;
+    const int halted = reinterpret_cast<WasmFunction>(static_cast<std::uintptr_t>(handle))(
+        static_cast<int>(reinterpret_cast<std::uintptr_t>(&state)));
+    if (halted) return true;
+    state.pc = state.npc;
+    state.downcount -= cycles;
+    UpdatePerformanceMonitorIfNeeded(cycles, loads, fp, state);
+    if (state.downcount <= 0 || *cpu_state != CPU::State::Running) return true;
+    // Mandatory guards BEFORE touching a descriptor that may have been freed or
+    // reused by a helper. A feature change re-enters the ordinary keyed lookup.
+    if (source_epoch == 0 || source_epoch != m_block_cache.StaticLinkEpoch() ||
+        source_features != static_cast<u32>(state.feature_flags)) return true;
+    const u8* next = nullptr;
+    if (links_enabled)
+      for (u32 i = 0; i < links->count && i < links->cells.size(); ++i)
+        if (links->cells[i].pc == state.pc) { next = links->cells[i].entry; break; }
+    if (!next)
