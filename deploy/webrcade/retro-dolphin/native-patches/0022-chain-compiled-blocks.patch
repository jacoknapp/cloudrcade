+// Standalone contracts for the actual fast-chain loop and generated blocks.
+// Product dispatch is excluded from these fixtures; gameplay covers real misses.
+#if DOLPHIN_WEB_STATIC_EXIT_LINKS
+int RunWasmFastChainSmoke()
+{
+  auto& system = Core::System::GetInstance();
+  CachedInterpreter jit(system);
+  auto& state = system.GetPPCState();
+  auto* cpu_state = const_cast<CPU::State*>(system.GetCPU().GetStatePtr());
+  const auto original_cpu = *cpu_state;
+  const auto original_features = state.feature_flags;
+  struct Restore
+  {
+    CPU::State* cpu; CPU::State original;
+    PowerPC::PowerPCState& state; decltype(state.feature_flags) features;
+    ~Restore() { *cpu = original; state.feature_flags = features; }
+  } restore{cpu_state, original_cpu, state, original_features};
+  using Callback = CachedInterpreter::AnyCallback;
+  using Operands = CachedInterpreter::WasmBlockOperands;
+  struct Entry { Callback callback; Operands operands; };
+  static_assert(offsetof(Entry, operands) == sizeof(Callback));
+  const auto callback = CachedInterpreter::AnyCallbackCast(
+      static_cast<s32 (*)(PowerPC::PowerPCState&, const Operands&)>(CachedInterpreter::RunWasmBlock));
+  const auto ptr = [](const void* p) { return reinterpret_cast<const u8*>(p); };
+  constexpr u32 pc0 = 0x80003100, pc1 = 0x80003200;
+  std::array<u8, 64> ram{};
+  const auto layout = MakeWasmBlockTestLayout(state, ram.data(), ram.size());
+  int handles[2]{};
+  for (u32 i = 0; i < 2; ++i)
+  {
+    const u32 pc = i ? pc1 : pc0, target = i ? pc0 : pc1;
+    auto add = MakeWasmBlockTestOp(EncodeDFormForWasmBlockTest(14, 3, 3, i + 1), pc);
+    add.regsIn[3] = true; add.regsOut[3] = true;
+    auto branch = MakeWasmBlockTestOp(
+        UGeckoInstruction{0x48000000u | ((target - pc - 4) & 0x03fffffcu)}, pc + 4);
+    branch.canEndBlock = true; branch.branchTo = target;
+    const std::array<PPCAnalyst::CodeOp, 2> ops{add, branch};
+    const auto bytes = BuildWasmCachedInterpreterBlock(ops, layout, pc + 8, false);
+    if (bytes.empty()) return 2000 + i;
+    handles[i] = CompileWasmCachedInterpreterBlockForTest(bytes);
+    if (handles[i] <= 0) return 2010 + i;
+  }
+  static CachedInterpreter* fixture = nullptr;
+  static CPU::State* fixture_cpu = nullptr;
+  static u32 action = 0;
+  fixture = &jit; fixture_cpu = cpu_state;
+  const auto control = +[](int address) -> int {
+    auto& st = *reinterpret_cast<PowerPC::PowerPCState*>(static_cast<std::uintptr_t>(address));
+    st.npc = pc1;
+    if (action == 1) fixture->m_block_cache.AdvanceStaticLinkEpoch();
+    if (action == 2) st.feature_flags = static_cast<decltype(st.feature_flags)>(1);
+    if (action == 3) *fixture_cpu = CPU::State::Stepping;
+    return action == 4 ? 1 : 0;
+  };
+  for (u32 test = 0; test < 10; ++test)
+  {
+    *cpu_state = CPU::State::Running;
+    state.feature_flags = static_cast<decltype(state.feature_flags)>(0);
+    state.pc = state.npc = pc0; state.msr.Hex = 0; state.gpr[3] = 7;
+    state.downcount = test == 1 ? 0 : test == 2 ? -1 : test == 0 ? 11 : 100;
+    u8 touched[2]{};
+    Entry entries[2]{{callback, {handles[0], &touched[0], pc1, 3, 0, 0, 1}},
+                     {callback, {handles[1], &touched[1], pc0, 3, 0, 0, 1}}};
+    entries[0].operands.links.count = entries[1].operands.links.count = 1;
+    entries[0].operands.links.cells[0] = {pc1, 0, ptr(&entries[1])};
+    entries[1].operands.links.cells[0] = {pc0, 0, ptr(&entries[0])};
+    if (test == 3) entries[0].operands.end_block = 0;
+    if (test == 4) entries[1].operands.end_block = 0;
+    if (test == 5) entries[0].operands.links.count = 0;
+    action = test >= 6 ? test - 5 : 0;
+    if (action)
+    {
+      entries[0].operands.handle = static_cast<s32>(reinterpret_cast<std::uintptr_t>(control));
+      // Must exit before inspecting a stale/invalid destination.
+      entries[0].operands.links.cells[0].entry = reinterpret_cast<const u8*>(1);
+    }
+    const u32 before = s_wasm_block_run_count, before_fast = s_wasm_fast_chain_blocks.load(std::memory_order_relaxed);
+    const bool handled = jit.ExecuteWasmFastChain(ptr(entries), false);
+    const u32 blocks = test == 0 ? 4 : test == 3 ? 0 : 1;
+    if (handled != (test != 3)) return 2100 + test;
+    if (s_wasm_block_run_count - before != blocks ||
+        s_wasm_fast_chain_blocks.load(std::memory_order_relaxed) - before_fast != blocks) return 2200 + test;
+    if (touched[0] != (blocks != 0) || touched[1] != (blocks > 1)) return 2300 + test;
+    if (test == 0 && (state.gpr[3] != 13 || state.pc != pc0 || state.npc != pc0 ||
+                      state.downcount != -1)) return 2400;
+    if (test == 9)
+    {
+      if (state.pc != pc0 || state.downcount != 100) return 2500;
+    }
+    else if (blocks == 1 && (state.pc != pc1 ||
+             state.downcount != (test == 1 ? -3 : test == 2 ? -4 : 97))) return 2600 + test;
+  }
+  fixture = nullptr; fixture_cpu = nullptr;
+  return 1;
+}
