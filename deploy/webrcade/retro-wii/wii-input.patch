+
+  WriteRamU32BE(exram.data(), 0x10, 0x11223344);
+  WriteRamU32BE(ram.data(), 0x10, 0x55667788);
+  WriteRamU32BE(exram.data(), 0x60, 0x3fc00000);
+  WriteRamU32BE(exram.data(), 0x64, 0xc0100000);
+  WriteRamU32BE(exram.data(), 0x68, 0x40091eb8);
+  WriteRamU32BE(exram.data(), 0x6c, 0x51eb851f);
