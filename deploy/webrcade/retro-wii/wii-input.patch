+// The Wasm EXRAM path assumes ea & 0x3fffffff is physical for the cached 0x9
+// window. Prove it from the live DBAT table for the whole EXRAM extent. DBAT
+// updates flush the JIT (MMU::DBATUpdated), so a stale proof is never reused.
+u32 s_wasm_mem2_window_bytes = 0;
+u32 s_wasm_mem2_stop_entry = 0;
+// Returns the length of the verified window starting at 0x90000000 (0 = off).
+// Accesses beyond it keep the MMU helper.
+static u32 WasmMem2DirectWindow(Core::System& system, const PowerPC::PowerPCState& ppc_state)
+{
+  auto& memory = system.GetMemory();
+  if (!system.IsWii() || memory.GetEXRAM() == nullptr || ppc_state.m_enable_dcache)
+    return 0;
+  const u32 size = std::min<u32>(memory.GetExRamSizeReal(), 0x10000000);
+  const auto& dbat = system.GetMMU().GetDBATTable();
+  u32 offset = 0;
+  for (; offset < size; offset += PowerPC::BAT_PAGE_SIZE)
+  {
+    const u32 entry = dbat[(0x90000000 + offset) >> PowerPC::BAT_INDEX_SHIFT];
+    if ((entry & (PowerPC::BAT_MAPPED_BIT | PowerPC::BAT_PHYSICAL_BIT | PowerPC::BAT_WI_BIT)) !=
+            (PowerPC::BAT_MAPPED_BIT | PowerPC::BAT_PHYSICAL_BIT) ||
+        (entry & PowerPC::BAT_RESULT_MASK) != 0x10000000 + offset)
+    {
+      s_wasm_mem2_stop_entry = entry;
+      break;
+    }
+  }
+  s_wasm_mem2_window_bytes = offset;
+  return offset;
+}
