+// Only the leading straight-line, helper-free integer prefix can define a GPR
+// before its incoming value is used. Read operands are decoded independently of
+// analyst liveness. Stop before memory, helpers, FP, branches or unknown ops.
+// Every surviving path executes the prefix before any conditional helper flush.
+BitSet32 GprPrefixDefinitions(std::span<const PPCAnalyst::CodeOp> ops)
+{
+  BitSet32 reads_before_write, defined;
+  for (const auto& op : ops)
+  {
+    if (op.skip) break;
+    const auto inst = op.inst;
+    BitSet32 reads, writes;
+    if (inst.OPCD == 14 || inst.OPCD == 15)
+    {
+      if (inst.RA) reads[inst.RA] = true;
+      writes[inst.RD] = true;
+    }
+    else if (inst.OPCD >= 24 && inst.OPCD <= 29)
+    {
+      reads[inst.RS] = true;
+      writes[inst.RA] = true;
+    }
+    else if (inst.OPCD == 20 || inst.OPCD == 21 || inst.OPCD == 23)
+    {
+      reads[inst.RS] = true;
+      if (inst.OPCD == 20) reads[inst.RA] = true;
+      if (inst.OPCD == 23) reads[inst.RB] = true;
+      writes[inst.RA] = true;
+    }
+    else if (inst.OPCD == 10 || inst.OPCD == 11)
+    {
+      reads[inst.RA] = true;
+    }
+    else break;
+    reads_before_write |= reads & ~defined;
+    defined |= writes;
+  }
+  return defined & ~reads_before_write;
+}
