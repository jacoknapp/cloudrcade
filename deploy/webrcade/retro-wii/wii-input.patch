+// Wii-only build: preserve a coherent native snapshot for the 200 Hz Remote poll.
+int DolphinWeb_GetWiiInput(int index, std::uint32_t* mask, std::uint8_t* values)
+{
+  if (index != 0) return 0;
+  const std::lock_guard<std::mutex> lock(s_input_state_mutex);
+  *mask = s_input_state.mask;
+  values[0] = s_input_state.stick_x;
+  values[1] = s_input_state.stick_y;
+  values[2] = s_input_state.c_stick_x;
+  values[3] = s_input_state.c_stick_y;
+  values[4] = s_input_state.trigger_left;
+  values[5] = s_input_state.trigger_right;
+  values[6] = s_input_state.analog_a;
+  values[7] = s_input_state.analog_b;
+  return 1;
+}
