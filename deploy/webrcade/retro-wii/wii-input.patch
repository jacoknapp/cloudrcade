+  state.gpr[6] = 0x24;
+  if (run_op(xform(4, 2, 6, 151)) != 0 || word(exram, 0x24) != 0xa1b2c3d4)
+    return 21;
+  if (run_op(EncodeDFormForWasmBlockTest(44, 4, 2, 0x28)) != 0 || word(exram, 0x28) != 0xc3d40000)
+    return 22;
+  if (run_op(EncodeDFormForWasmBlockTest(38, 4, 2, 0x2c)) != 0 || word(exram, 0x2c) != 0xd4000000)
+    return 23;
+  if (run_op(EncodeDFormForWasmBlockTest(36, 4, 5, 0x20)) != 0 || word(ram, 0x20) != 0xa1b2c3d4)
