+#ifdef __EMSCRIPTEN__
+// Opt-in paused diagnostics: reads the same report builder used by Wii Bluetooth.
+// Never called in the frame loop and never changes controller state.
+extern "C" EMSCRIPTEN_KEEPALIVE const u32* DolphinWeb_GetWiiReport()
+{
+  static std::array<u32, 12> report{};
+  auto* remote = static_cast<Wiimote*>(::Wiimote::GetConfig()->GetController(0));
+  DesiredWiimoteState state;
+  remote->PrepareInput(&state, WiimoteCommon::HIDWiimote::SensorBarState::Enabled);
+  const auto nunchuk = std::get<Nunchuk::DesiredState>(state.extension.data);
+  report = {remote->GetCurrentlyPressedButtons().hex, state.acceleration.value.x, state.acceleration.value.y,
+      state.acceleration.value.z, state.camera_points[0].position.x,
+      state.camera_points[0].position.y, state.camera_points[1].position.x,
+      state.camera_points[1].position.y, nunchuk.jx, nunchuk.jy, nunchuk.GetButtons(),
+      state.motion_plus.has_value() ? 1u : 0u};
+  return report.data();
+}
+#endif
