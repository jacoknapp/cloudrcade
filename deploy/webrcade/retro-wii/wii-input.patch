+// Retarget a C++ fast helper from MEM1 to Wii EXRAM when the access is
+// translated by a cached DBAT into EXRAM and stays within one BAT page. Leaves
+// the MEM1 selection unchanged otherwise, so callers keep their MMU fallback.
+static void SelectWiiMem2Window(Core::System& system, const PowerPC::PowerPCState& ppc_state,
+                                u32 address, u32 bytes, u8*& ram, u32& offset, u32& ram_size)
+{
+  if (offset < ram_size || !ppc_state.msr.DR || ppc_state.m_enable_dcache || !system.IsWii())
+    return;
+  auto& memory = system.GetMemory();
+  if (memory.GetEXRAM() == nullptr || bytes == 0 || bytes > PowerPC::BAT_PAGE_SIZE ||
+      (address & (PowerPC::BAT_PAGE_SIZE - 1)) > PowerPC::BAT_PAGE_SIZE - bytes)
+    return;
+  const u32 entry = system.GetMMU().GetDBATTable()[address >> PowerPC::BAT_INDEX_SHIFT];
+  if ((entry & (PowerPC::BAT_MAPPED_BIT | PowerPC::BAT_PHYSICAL_BIT | PowerPC::BAT_WI_BIT)) !=
+      (PowerPC::BAT_MAPPED_BIT | PowerPC::BAT_PHYSICAL_BIT))
+    return;
+  const u32 physical =
+      (entry & PowerPC::BAT_RESULT_MASK) | (address & (PowerPC::BAT_PAGE_SIZE - 1));
+  if ((physical >> 28) != 0x1)
+    return;
+  ram = memory.GetEXRAM();
+  offset = physical & 0x0fffffff;
+  ram_size = memory.GetExRamSizeReal();
+}
