+      !NearlyEqualForWasmBlockTest(state.ps[2].PS0AsDouble(), 3.14))
+    return 31;
+  if (run_op(EncodeDFormForWasmBlockTest(52, 1, 2, 0x70)) != 0 || word(exram, 0x70) != 0x3fc00000)
+    return 32;
+  if (run_op(EncodeDFormForWasmBlockTest(54, 2, 2, 0x78)) != 0 || word(exram, 0x78) != 0x40091eb8 ||
+      word(exram, 0x7c) != 0x51eb851f)
+    return 33;
+  // psq_l f3,0x60(r2),0,0 (float GQR) and psq_st
+  if (run_op(EncodeDFormForWasmBlockTest(56, 3, 2, 0x60)) != 0 ||
+      !NearlyEqualForWasmBlockTest(state.ps[3].PS0AsDouble(), 1.5) ||
+      !NearlyEqualForWasmBlockTest(state.ps[3].PS1AsDouble(), -2.25))
+    return 40;
+  if (run_op(EncodeDFormForWasmBlockTest(60, 3, 2, 0x80)) != 0 || word(exram, 0x80) != 0x3fc00000 ||
+      word(exram, 0x84) != 0xc0100000)
+    return 41;
+  // dcbz 0,r7 clears one EXRAM line.
+  for (u32 i = 0xa0; i < 0xc0; ++i)
+    exram[i] = 0xee;
+  state.gpr[7] = 0x900000a4;
+  if (run_op(xform(0, 0, 7, 1014)) != 0)
+    return 50;
+  for (u32 i = 0xa0; i < 0xc0; ++i)
+    if (exram[i] != 0)
+      return 51;
+  if (exram[0x9f] != 0 || exram[0xc0] != 0)
+    return 52;
+  return state.npc == 0x80003504 ? 1 : 60;
 }
 
