+#if defined(__EMSCRIPTEN__)
+constexpr GLenum COMPLETION_STATUS = 0x91B1; // GL_COMPLETION_STATUS_KHR
+
+bool ProgramsLinkInBackground() {
+    static const bool available = EM_ASM_INT({
+        try {
+            // Module.wrcShaderWait (set by the frontend) restores waiting for each program.
+            return !Module.wrcShaderWait && Module.ctx &&
+                Module.ctx.getExtension('KHR_parallel_shader_compile') ? 1 : 0;
+        } catch (e) {
+            return 0;
+        }
+    }) != 0;
+    return available;
+}
+
+GLuint BeginProgram(std::span<const GLuint> shaders) {
+    const GLuint program_id = glCreateProgram();
+    for (GLuint shader : shaders) {
+        if (shader != 0) {
+            glAttachShader(program_id, shader);
+        }
+    }
+    glLinkProgram(program_id);
+    return program_id;
+}
+
+bool IsProgramLinked(GLuint program) {
+    GLint done = GL_FALSE;
+    glGetProgramiv(program, COMPLETION_STATUS, &done);
+    return done == GL_TRUE;
+}
+
+void FinishProgram(GLuint program_id, const std::string& debug_name) {
+
+    // Check the program
+    GLint result = GL_FALSE;
+    GLint info_log_length;
+    glGetProgramiv(program_id, GL_LINK_STATUS, &result);
+    glGetProgramiv(program_id, GL_INFO_LOG_LENGTH, &info_log_length);
+
+    if (info_log_length > 1) {
+        std::vector<char> program_error(info_log_length);
+        glGetProgramInfoLog(program_id, info_log_length, nullptr, &program_error[0]);
+        if (result == GL_TRUE) {
+            LOG_DEBUG(Render_OpenGL, "Link message for shader {}:\n{}", debug_name,
+                      &program_error[0]);
+        } else {
+            LOG_ERROR(Render_OpenGL, "Error linking shader {}:\n{}", debug_name, &program_error[0]);
+        }
+    } else if (result == GL_FALSE) {
+        LOG_ERROR(Render_OpenGL, "Error linking shader {}: No log produced.", debug_name);
+    }
+
+    GLuint attached[4];
+    GLsizei count = 0;
+    glGetAttachedShaders(program_id, 4, &count, attached);
+    for (GLsizei index = 0; index < count; ++index) {
+        glDetachShader(program_id, attached[index]);
+    }
+
+#if defined(__EMSCRIPTEN__)
+    if (result == GL_TRUE) {
+        glUseProgram(program_id);
+        const auto set_sampler = [&](const char* name, GLint unit) {
