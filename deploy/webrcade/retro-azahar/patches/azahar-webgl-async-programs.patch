+        set_sampler("shadow_texture_py", 10);
+        set_sampler("shadow_texture_ny", 11);
+        set_sampler("shadow_texture_pz", 12);
+        set_sampler("shadow_texture_nz", 13);
+        set_sampler("shadow_buffer", 14);
+#endif
