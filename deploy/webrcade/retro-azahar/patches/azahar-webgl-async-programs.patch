+        set_sampler("tex0", 0);
+        set_sampler("tex1", 1);
+        set_sampler("tex2", 2);
+        set_sampler("texture_buffer_lut_lf", 3);
+        set_sampler("texture_buffer_lut_rg", 4);
+        set_sampler("texture_buffer_lut_rgba", 5);
+        set_sampler("tex_normal", 6);
