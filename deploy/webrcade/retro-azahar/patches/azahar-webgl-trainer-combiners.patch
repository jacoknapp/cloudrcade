+// Share the reflection calculation across single-light materials using the common signed inputs.
+// More complex lights retain the existing individually generated equations.
+static std::optional<std::array<s32, 3>> ReflectionControls(const LightConfig& lighting) {
+    if (!lighting.enable || lighting.src_num != 1) {
+        return std::nullopt;
+    }
+    using Sampler = LightingRegs::LightingSampler;
+    using Input = LightingRegs::LightingLutInput;
+    constexpr std::array samplers{Sampler::ReflectRed, Sampler::ReflectGreen, Sampler::ReflectBlue};
+    const std::array tables{lighting.lut_rr, lighting.lut_rg, lighting.lut_rb};
+    std::array<s32, 3> controls{};
+    for (std::size_t i = 0; i < tables.size(); ++i) {
+        const auto& lut = tables[i];
+        if (!lut.enable || !LightingRegs::IsLightingSamplerSupported(lighting.config, samplers[i])) {
+            continue;
+        }
+        if (lut.abs_input) {
+            return std::nullopt;
+        }
+        s32 index;
+        switch (lut.type.Value()) {
+        case Input::NH: index = 1; break;
+        case Input::NV: index = 2; break;
+        case Input::LN: index = 3; break;
+        default: return std::nullopt;
+        }
+        // PICA scales are exact multiples of one quarter.
+        controls[i] = (static_cast<s32>(lut.GetScale() * 4.0f) << 2) | index;
+    }
+    return controls;
+}
