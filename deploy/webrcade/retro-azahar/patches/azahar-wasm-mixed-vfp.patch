+// Single-precision VFP operations that can share compact ARM runs.
+#pragma once
+
+#include "core/arm/dyncom/wasm_arm_ops.h"
+
+namespace WasmArm {
+
+constexpr bool IsVfp(Operation op) {
+    return op >= Operation::LoadFloat;
+}
+
+inline bool DecodeVfp(std::uint32_t word, Instruction& out) {
+    if (word >> 28 != 14)
+        return false;
+
+    // VLDR/VSTR with a single-precision register and no writeback.
+    if ((word & 0x0f200f00) == 0x0d000a00) {
+        const auto rn = static_cast<std::uint8_t>((word >> 16) & 15);
+        const auto sd = static_cast<std::uint8_t>(((word >> 11) & 30) | ((word >> 22) & 1));
+        const auto offset = (word & 255u) << 2;
+        const auto op = word & (1u << 20) ? Operation::LoadFloat : Operation::StoreFloat;
+        out = {word & (1u << 23) ? offset : 0u - offset, op, sd, rn, Immediate};
+        return true;
+    }
+
+    // Scalar-register encodings for VMLA, VMUL, VADD and VSUB. Rounding,
+    // vectors and exceptions are still handled by the existing VFP engine.
+    if ((word & 0x0f800f10) != 0x0e000a00)
+        return false;
+    switch (word & 0x00b00040) {
+    case 0:
+    case 0x00200000:
+    case 0x00300000:
+    case 0x00300040:
+        out = {word, Operation::ScalarFloat, 0, 0, 0};
+        return true;
+    default:
+        return false;
+    }
+}
+
+template <class Cpu>
+inline std::uint32_t VfpAddress(const Cpu& cpu, const Instruction& inst, std::uint32_t pc) {
+    const auto base = inst.rn == 15 ? (pc & ~3u) + 8u : cpu.Reg[inst.rn];
+    return base + inst.immediate;
+}
+
+template <class Cpu, class ExecuteScalar>
+inline void ExecuteVfp(Cpu& cpu, const Instruction& inst, ExecuteScalar execute_scalar) {
+    if (inst.operation == Operation::ScalarFloat) {
+        execute_scalar(cpu, inst.immediate);
+        return;
+    }
+    const auto address = VfpAddress(cpu, inst, cpu.Reg[15]);
+    if (inst.operation == Operation::LoadFloat)
+        cpu.ExtReg[inst.rd] = cpu.ReadMemory32(address);
+    else
+        cpu.WriteMemory32(address, cpu.ExtReg[inst.rd]);
+}
+
+template <class Cpu, class InstructionAt, class ExecuteScalar>
+inline unsigned RunMappedWithVfp(Cpu& cpu, std::uint8_t* const* pages, unsigned count,
+                                  InstructionAt instruction_at, ExecuteScalar execute_scalar) {
+    unsigned i = 0;
+    for (; i < count; ++i) {
+        const auto& inst = instruction_at(i);
+        if (!IsVfp(inst.operation)) {
+            if (!ExecuteMapped(cpu, inst, pages))
+                break;
+            continue;
+        }
+        if (inst.operation == Operation::ScalarFloat) {
+            execute_scalar(cpu, inst.immediate);
+            continue;
+        }
+        const auto address = VfpAddress(cpu, inst, cpu.Reg[15] + 4 * i);
+        const auto offset = address & 4095u;
+        auto* page = pages[address >> 12];
+        if (!page || offset > 4092)
+            break;
+        if (inst.operation == Operation::LoadFloat)
+            std::memcpy(&cpu.ExtReg[inst.rd], page + offset, 4);
+        else
+            std::memcpy(page + offset, &cpu.ExtReg[inst.rd], 4);
+    }
+    return i;
+}
+
+} // namespace WasmArm
