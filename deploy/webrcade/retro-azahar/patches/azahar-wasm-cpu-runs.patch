diff --git a/src/core/arm/dyncom/wasm_arm_stack.h b/src/core/arm/dyncom/wasm_arm_stack.h
new file mode 100644
index 0000000..630c456
--- /dev/null
+++ b/src/core/arm/dyncom/wasm_arm_stack.h
@@ -0,0 +1,56 @@
+// Fast path for ordinary little-endian ARM register saves and restores.
+#pragma once
+
+#include <bit>
+#include <cstdint>
+#include <cstring>
+
+namespace WasmArmStack {
+
+template<bool Pop, class Cpu>
+inline bool TryTransfer(Cpu& cpu, std::uint32_t word, bool debug_enabled, std::uint8_t* const* pages) {
+    // STMDB sp!, {...} / LDMIA sp!, {...}, unconditional and without the user-bank bit.
+    if ((word >> 16) != (Pop ? 0xe8bd : 0xe92d) ||
+        debug_enabled || cpu.TFlag || cpu.InBigEndianMode())
+        return false;
+
+    const unsigned mask = word & 0xffff;
+    // Leave the base register, stacked PC, combined LR/PC restore and single-register
+    // aliases to the ordinary interpreter. A POP may restore PC instead of LR.
+    if ((mask & (1u << 13)) || (!Pop && (mask & (1u << 15))) ||
+        (Pop && (mask & 0xc000) == 0xc000) || !(mask & (mask - 1)))
+        return false;
+
+    const std::uint32_t sp = cpu.Reg[13];
+    const unsigned size = 4 * std::popcount(mask);
+    const std::uint32_t updated = Pop ? sp + size : sp - size;
+    const std::uint32_t first = Pop ? sp : updated;
+    const unsigned offset = first & 4095;
+    if ((sp & 3) || (Pop ? updated < sp : updated > sp) || offset + size > 4096)
+        return false;
+
+    auto* page = pages[first >> 12];
+    if (!page)
+        return false;
+
+    // All bytes belong to ordinary RAM. No callback can observe a partial transfer.
+    cpu.Reg[13] = updated;
+    auto* cursor = page + offset;
+    for (unsigned left = mask; left; left &= left - 1) {
+        const unsigned reg = std::countr_zero(left);
+        if constexpr (Pop)
+            std::memcpy(&cpu.Reg[reg], cursor, 4);
+        else
+            std::memcpy(cursor, &cpu.Reg[reg], 4);
+        cursor += 4;
+    }
+    if constexpr (Pop) {
+        if (mask & (1u << 15)) {
+            cpu.TFlag = cpu.Reg[15] & 1;
+            cpu.Reg[15] &= ~1u;
+        }
+    }
+    return true;
+}
+
+} // namespace WasmArmStack
diff --git a/src/core/arm/dyncom/wasm_recent_blocks.h b/src/core/arm/dyncom/wasm_recent_blocks.h
new file mode 100644
index 0000000..0caa619
--- /dev/null
+++ b/src/core/arm/dyncom/wasm_recent_blocks.h
@@ -0,0 +1,62 @@
+// Direct-mapped front end to the browser interpreter's decoded block cache.
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+class WasmRecentBlocks {
+public:
+    bool Find(std::uint32_t key, std::size_t& offset) const {
+        const auto& entry = slots[Index(key)];
+        if (!entry.offset_plus_one || entry.key != key) return false;
+        offset = entry.offset_plus_one - 1;
+        return true;
+    }
+
+    void Store(std::uint32_t key, std::size_t offset) {
+        slots[Index(key)] = {key, offset + 1};
+    }
+
+    // Each decoded branch predicts its last successor. Its source may still
+    // physically exist when a memory callback invalidates the arena mid-block.
+    struct BranchLink {
+        std::uint32_t generation;
+        std::uint32_t target_pc{};
+        std::uint32_t offset_plus_one{};
+    };
+
+    BranchLink NewBranchLink() const { return {generation}; }
+
+    bool FindBranch(BranchLink& link, std::uint32_t target_pc, std::size_t& offset) const {
+        if (!generation || link.generation != generation) return false;
+        if (link.offset_plus_one && link.target_pc == target_pc) {
+            offset = link.offset_plus_one - 1;
+            return true;
+        }
+        if (!Find(target_pc, offset)) return false;
+        link.target_pc = target_pc;
+        link.offset_plus_one = static_cast<std::uint32_t>(offset) + 1;
+        return true;
+    }
+
+    void Clear() {
+        slots.fill({});
+        InvalidateBranchLinks();
+    }
+
+    void InvalidateBranchLinks() {
+        // Wrapping disables predictions so no old generation can match again.
+        if (generation) ++generation;
+    }
+
+private:
+    struct Entry {
+        std::uint32_t key;
+        std::size_t offset_plus_one;
+    };
+    static constexpr std::size_t Count = 4096;
+    static constexpr std::size_t Index(std::uint32_t key) { return (key >> 1) & (Count - 1); }
+    std::array<Entry, Count> slots{};
+    std::uint32_t generation = 1;
+};
