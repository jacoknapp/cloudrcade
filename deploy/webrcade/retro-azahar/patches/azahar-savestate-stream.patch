+/**
+ * Stream buffers that compress or decompress in small pieces, for data that is too large to
+ * hold uncompressed. The frame they write has no content size, so it can only be read back
+ * with ZSTDReadBuffer.
+ */
+class ZSTDWriteBuffer : public std::streambuf {
+public:
+    explicit ZSTDWriteBuffer(std::vector<u8>& output);
+    ~ZSTDWriteBuffer() override;
+
+    /// Ends the frame. Returns false if any part of the data could not be compressed.
+    [[nodiscard]] bool Finish();
+
+protected:
+    int_type overflow(int_type character) override;
+    std::streamsize xsputn(const char* data, std::streamsize size) override;
+
+private:
+    bool Feed(const char* data, std::size_t size, bool end);
+
+    void* context;
+    std::vector<u8>& output;
+    std::vector<u8> piece;
+    bool failed{};
+};
+
+class ZSTDReadBuffer : public std::streambuf {
+public:
+    explicit ZSTDReadBuffer(std::span<const u8> compressed);
+    ~ZSTDReadBuffer() override;
+
+protected:
+    int_type underflow() override;
+
+private:
+    void* context;
+    std::span<const u8> input;
+    std::size_t position{};
+    std::vector<char> piece;
+};
+
 } // namespace Common::Compression
 
