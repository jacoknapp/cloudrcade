+constexpr std::size_t STREAM_PIECE_SIZE = 1 << 18;
+
+ZSTDWriteBuffer::ZSTDWriteBuffer(std::vector<u8>& output_)
+    : context{ZSTD_createCCtx()}, output{output_}, piece(STREAM_PIECE_SIZE) {}
+
+ZSTDWriteBuffer::~ZSTDWriteBuffer() {
+    ZSTD_freeCCtx(static_cast<ZSTD_CCtx*>(context));
+}
+
+bool ZSTDWriteBuffer::Feed(const char* data, std::size_t size, bool end) {
+    if (failed || !context) {
+        failed = true;
+        return false;
+    }
+    ZSTD_inBuffer in{data, size, 0};
+    for (;;) {
+        ZSTD_outBuffer out{piece.data(), piece.size(), 0};
+        const std::size_t remaining = ZSTD_compressStream2(
+            static_cast<ZSTD_CCtx*>(context), &out, &in, end ? ZSTD_e_end : ZSTD_e_continue);
+        if (ZSTD_isError(remaining)) {
+            LOG_ERROR(Common, "Error compressing ZSTD stream: {}", ZSTD_getErrorName(remaining));
+            failed = true;
+            return false;
+        }
+        output.insert(output.end(), piece.begin(), piece.begin() + out.pos);
+        if (end ? remaining == 0 : in.pos == in.size) {
+            return true;
+        }
+    }
+}
+
+bool ZSTDWriteBuffer::Finish() {
+    return Feed(nullptr, 0, true);
+}
+
+ZSTDWriteBuffer::int_type ZSTDWriteBuffer::overflow(int_type character) {
+    if (traits_type::eq_int_type(character, traits_type::eof())) {
+        return traits_type::not_eof(character);
+    }
+    const char value = traits_type::to_char_type(character);
+    return Feed(&value, 1, false) ? character : traits_type::eof();
+}
+
+std::streamsize ZSTDWriteBuffer::xsputn(const char* data, std::streamsize size) {
+    return Feed(data, static_cast<std::size_t>(size), false) ? size : 0;
+}
+
+ZSTDReadBuffer::ZSTDReadBuffer(std::span<const u8> compressed)
+    : context{ZSTD_createDCtx()}, input{compressed}, piece(STREAM_PIECE_SIZE) {}
+
+ZSTDReadBuffer::~ZSTDReadBuffer() {
+    ZSTD_freeDCtx(static_cast<ZSTD_DCtx*>(context));
+}
+
+ZSTDReadBuffer::int_type ZSTDReadBuffer::underflow() {
+    if (gptr() < egptr()) {
+        return traits_type::to_int_type(*gptr());
+    }
+    if (!context) {
+        return traits_type::eof();
+    }
+    ZSTD_inBuffer in{input.data(), input.size(), position};
+    ZSTD_outBuffer out{piece.data(), piece.size(), 0};
+    while (out.pos == 0 && in.pos < in.size) {
+        const std::size_t result =
+            ZSTD_decompressStream(static_cast<ZSTD_DCtx*>(context), &out, &in);
+        if (ZSTD_isError(result)) {
+            LOG_ERROR(Common, "Error decompressing ZSTD stream: {}", ZSTD_getErrorName(result));
+            return traits_type::eof();
+        }
+    }
+    position = in.pos;
+    if (out.pos == 0) {
+        return traits_type::eof();
+    }
+    setg(piece.data(), piece.data(), piece.data() + out.pos);
+    return traits_type::to_int_type(*gptr());
+}
+
 std::size_t GetDecompressedSize(std::span<const u8> compressed) {
     return ZSTD_getFrameContentSize(compressed.data(), compressed.size());
 }
