+GLuint RebuiltShader(GLenum type, std::string_view preamble, std::string_view source) {
+    State& state = Get();
+    if (state.compiled.empty()) {
+        return 0;
+    }
+    std::string text{preamble};
+    text += source;
+    const u64 hash = Common::ComputeHash64(text.data(), text.size());
+    const auto compiled = state.compiled.find(hash);
+    const auto saved = state.sources.find(hash);
+    if (compiled == state.compiled.end() || saved == state.sources.end() ||
+        saved->second.type != type || saved->second.text->first != text) {
+        return 0;
+    }
+    return compiled->second;
+}
+
+bool OwnsShader(GLuint shader) {
+    State& state = Get();
+    const auto identity = state.hashes.find(shader);
+    if (identity == state.hashes.end()) {
+        return false;
+    }
+    const auto compiled = state.compiled.find(identity->second.hash);
+    return compiled != state.compiled.end() && compiled->second == shader;
+}
+
+bool SameShader(GLuint a, GLuint b) {
+    if (a == b) {
+        return true;
+    }
+    const auto& identities = Get().hashes;
+    const auto first = identities.find(a);
+    const auto second = identities.find(b);
+    return first != identities.end() && second != identities.end() &&
+           first->second.text == second->second.text;
+}
 
