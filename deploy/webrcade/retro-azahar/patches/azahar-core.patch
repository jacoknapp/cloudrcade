+void NCCHContainer::SetupCIACrypto() {
+    if (cia_crypto_checked || ncch_offset == 0) {
+        return;
+    }
+    cia_crypto_checked = true;
+
+    // A non-zero offset is also used for other containers; only act on a real CIA whose
+    // main content starts exactly where this NCCH is expected.
+    // Check the fixed header fields first, parsing anything else as a CIA reads garbage sizes.
+    struct {
+        u32_le header_size;
+        u16_le type;
+        u16_le version;
+        u32_le cert_size;
+        u32_le tik_size;
+        u32_le tmd_size;
+    } probe{};
+    static constexpr u32 max_section_size = 0x100000;
+    file->Seek(0, SEEK_SET);
+    if (is_ncsd || file->ReadBytes(&probe, sizeof(probe)) != sizeof(probe) ||
+        probe.header_size != sizeof(CIAHeader) || probe.cert_size > max_section_size ||
+        probe.tik_size == 0 || probe.tik_size > max_section_size || probe.tmd_size == 0 ||
+        probe.tmd_size > max_section_size) {
+        return;
+    }
+
+    CIAContainer cia;
+    file->Seek(0, SEEK_SET);
+    if (cia.Load(file.get()) != Loader::ResultStatus::Success) {
+        return;
+    }
+    if (cia.GetContentOffset(0) != ncch_offset || cia.GetContentSize(0) == 0) {
+        return;
+    }
+    const TitleMetadata& tmd = cia.GetTitleMetadata();
+    if (!(tmd.GetContentTypeByIndex(0) & TMDContentTypeFlag::Encrypted)) {
+        return;
+    }
+
+    HW::AES::InitKeys();
+    const auto title_key = cia.GetTicket().GetTitleKey();
+    if (!title_key) {
+        LOG_ERROR(Service_FS, "No title key available for encrypted CIA {}", filepath);
+        return;
+    }
+
+    CryptoRegion region;
+    region.mode = CryptoRegion::Mode::CBC;
+    region.begin = ncch_offset;
+    region.end = region.begin + cia.GetContentSize(0);
+    region.key = *title_key;
+    region.iv = tmd.GetContentCTRByIndex(0);
+    cia_regions.push_back(region);
+
+    file = std::make_unique<DecryptedIOFile>(std::move(file), cia_regions);
+}
+
+Loader::ResultStatus NCCHContainer::SetupNCCHCrypto() {
+    if (!ncch_regions.empty()) {
+        return Loader::ResultStatus::Success;
+    }
+
+    const u64 raw_exefs_begin =
+        static_cast<u64>(ncch_offset) + static_cast<u64>(ncch_header.exefs_offset) * kBlockSize;
+    if (ncch_header.exefs_size) {
+        // Some dumps are already decrypted but keep the crypto flags of the original. A
+        // readable ExeFS section table gives those away; they need no decryption.
+        ExeFs_Header raw_header;
+        const u64 original_position = file->Tell();
+        const bool read_ok =
+            file->Seek(static_cast<s64>(raw_exefs_begin), SEEK_SET) &&
+            file->ReadBytes(reinterpret_cast<u8*>(&raw_header), sizeof(raw_header)) ==
+                sizeof(raw_header);
+        file->Clear();
+        file->Seek(static_cast<s64>(original_position), SEEK_SET);
+        if (read_ok) {
+            static constexpr std::array<const char*, 4> known_names{".code", "icon", "banner",
+                                                                    "logo"};
+            const bool is_plain =
+                std::any_of(known_names.begin(), known_names.end(), [&](const char* name) {
+                    return std::strncmp(raw_header.section[0].name, name,
+                                        sizeof(raw_header.section[0].name)) == 0;
+                }) &&
+                std::all_of(std::begin(raw_header.reserved), std::end(raw_header.reserved),
+                            [](u8 value) { return value == 0; });
+            if (is_plain) {
+                LOG_INFO(Service_FS, "NCCH is flagged as encrypted but its contents are not");
+                return Loader::ResultStatus::Success;
+            }
+        }
+    }
+
+    using HW::AES::AESKey;
+    AESKey primary_key{};
+    AESKey secondary_key{};
+
+    if (!ncch_header.fixed_key) {
+        HW::AES::InitKeys();
+
+        AESKey key_y_primary;
+        std::memcpy(key_y_primary.data(), ncch_header.signature, key_y_primary.size());
+        AESKey key_y_secondary = key_y_primary;
+
+        if (ncch_header.seed_crypto) {
+            const auto seed = GetSeed(ncch_header.program_id);
+            if (!seed) {
+                LOG_ERROR(Service_FS, "Seed for program {:016X} not found",
+                          static_cast<u64>(ncch_header.program_id));
+                return Loader::ResultStatus::ErrorEncrypted;
+            }
+            std::array<u8, 32> input;
+            std::memcpy(input.data(), key_y_primary.data(), key_y_primary.size());
+            std::memcpy(input.data() + key_y_primary.size(), seed->data(), seed->size());
+            std::array<u8, CryptoPP::SHA256::DIGESTSIZE> hash;
+            CryptoPP::SHA256().CalculateDigest(hash.data(), input.data(), input.size());
+            std::memcpy(key_y_secondary.data(), hash.data(), key_y_secondary.size());
+        }
+
+        std::size_t secondary_slot;
+        switch (ncch_header.secondary_key_slot) {
+        case 0:
+            secondary_slot = HW::AES::KeySlotID::NCCHSecure1;
+            break;
+        case 1:
+            secondary_slot = HW::AES::KeySlotID::NCCHSecure2;
+            break;
+        case 10:
+            secondary_slot = HW::AES::KeySlotID::NCCHSecure3;
+            break;
+        case 11:
+            secondary_slot = HW::AES::KeySlotID::NCCHSecure4;
+            break;
+        default:
+            LOG_ERROR(Service_FS, "Unknown NCCH secondary key slot {}",
+                      ncch_header.secondary_key_slot);
+            return Loader::ResultStatus::ErrorEncrypted;
+        }
+
+        HW::AES::SetKeyY(HW::AES::KeySlotID::NCCHSecure1, key_y_primary);
+        if (!HW::AES::IsNormalKeyAvailable(HW::AES::KeySlotID::NCCHSecure1)) {
+            LOG_ERROR(Service_FS, "Primary NCCH key is not available");
+            return Loader::ResultStatus::ErrorEncrypted;
+        }
+        primary_key = HW::AES::GetNormalKey(HW::AES::KeySlotID::NCCHSecure1);
+
+        HW::AES::SetKeyY(secondary_slot, key_y_secondary);
+        if (!HW::AES::IsNormalKeyAvailable(secondary_slot)) {
+            LOG_ERROR(Service_FS, "Secondary NCCH key (slot 0x{:02X}) is not available",
+                      secondary_slot);
+            return Loader::ResultStatus::ErrorEncrypted;
+        }
+        secondary_key = HW::AES::GetNormalKey(secondary_slot);
+    }
+
+    const u64 exheader_begin = static_cast<u64>(ncch_offset) + sizeof(NCCH_Header);
+    const u64 exefs_begin =
+        static_cast<u64>(ncch_offset) + static_cast<u64>(ncch_header.exefs_offset) * kBlockSize;
+    const u64 exefs_size = static_cast<u64>(ncch_header.exefs_size) * kBlockSize;
+    const u64 romfs_begin =
+        static_cast<u64>(ncch_offset) + static_cast<u64>(ncch_header.romfs_offset) * kBlockSize;
+    const u64 romfs_size = static_cast<u64>(ncch_header.romfs_size) * kBlockSize;
+
+    // Section counters depend on the NCCH version
+    const auto make_ctr = [this](u8 section, u32 section_offset) {
+        std::array<u8, 16> ctr{};
+        if (ncch_header.version == 1) {
+            std::memcpy(ctr.data(), ncch_header.partition_id, 8);
+            ctr[12] = static_cast<u8>(section_offset >> 24);
+            ctr[13] = static_cast<u8>(section_offset >> 16);
+            ctr[14] = static_cast<u8>(section_offset >> 8);
+            ctr[15] = static_cast<u8>(section_offset);
+        } else {
+            std::reverse_copy(ncch_header.partition_id, ncch_header.partition_id + 8, ctr.begin());
+            ctr[8] = section;
+        }
+        return ctr;
+    };
+    const auto make_region = [](u64 begin, u64 size, u64 origin, const AESKey& key,
+                                const std::array<u8, 16>& ctr) {
+        CryptoRegion region;
+        region.mode = CryptoRegion::Mode::CTR;
+        region.begin = begin;
+        region.end = begin + size;
+        region.origin = origin;
+        region.key = key;
+        region.iv = ctr;
+        return region;
+    };
+
+    CryptoRegions regions;
+    if (ncch_header.extended_header_size) {
+        // Extended header followed by the access descriptor
+        regions.push_back(make_region(exheader_begin, 0x800, exheader_begin, primary_key,
+                                      make_ctr(1, sizeof(NCCH_Header))));
+    }
+    if (exefs_size >= sizeof(ExeFs_Header)) {
+        const auto exefs_ctr = make_ctr(2, ncch_header.exefs_offset * kBlockSize);
+        const CryptoRegion header_region =
+            make_region(exefs_begin, sizeof(ExeFs_Header), exefs_begin, primary_key, exefs_ctr);
+        regions.push_back(header_region);
+
+        // The section table tells which key each file uses
+        ExeFs_Header header;
+        const u64 original_position = file->Tell();
+        const bool read_ok = file->Seek(static_cast<s64>(exefs_begin), SEEK_SET) &&
+                             file->ReadBytes(reinterpret_cast<u8*>(&header), sizeof(header)) ==
+                                 sizeof(header);
+        file->Seek(static_cast<s64>(original_position), SEEK_SET);
+        if (!read_ok) {
+            return Loader::ResultStatus::Error;
+        }
+        DecryptCTR(header_region, exefs_begin, reinterpret_cast<u8*>(&header), sizeof(header));
+        for (const auto& section : header.section) {
+            if (section.size == 0) {
+                continue;
+            }
+            const bool uses_primary = std::strncmp(section.name, "icon", sizeof(section.name)) == 0 ||
+                                      std::strncmp(section.name, "banner", sizeof(section.name)) == 0;
+            const u64 begin = exefs_begin + sizeof(ExeFs_Header) + section.offset;
+            if (begin + section.size > exefs_begin + exefs_size) {
+                LOG_ERROR(Service_FS, "ExeFS section table is invalid, wrong NCCH keys?");
+                return Loader::ResultStatus::ErrorEncrypted;
+            }
+            regions.push_back(make_region(begin, section.size, exefs_begin,
+                                          uses_primary ? primary_key : secondary_key, exefs_ctr));
+        }
+    }
+    if (romfs_size) {
+        regions.push_back(make_region(romfs_begin, romfs_size, romfs_begin, secondary_key,
+                                      make_ctr(3, ncch_header.romfs_offset * kBlockSize)));
+    }
+    if (regions.empty()) {
+        return Loader::ResultStatus::ErrorEncrypted;
+    }
+
+    const u64 position = file->Tell();
+    ncch_regions = std::move(regions);
+    file = std::make_unique<DecryptedIOFile>(std::move(file), ncch_regions);
+    file->Seek(static_cast<s64>(position), SEEK_SET);
+    return Loader::ResultStatus::Success;
+}
+
 } // namespace FileSys
