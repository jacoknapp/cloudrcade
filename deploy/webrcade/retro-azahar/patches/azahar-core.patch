+
+namespace FileSys {
+
+namespace {
+constexpr u64 BLOCK_SIZE = 16;
+} // namespace
+
+void DecryptCTR(const CryptoRegion& region, u64 offset, u8* data, std::size_t length) {
+    CryptoPP::CTR_Mode<CryptoPP::AES>::Decryption dec(region.key.data(), region.key.size(),
+                                                      region.iv.data());
+    dec.Seek(offset - region.origin);
+    dec.ProcessData(data, data, length);
+}
+
+DecryptedIOFile::DecryptedIOFile() = default;
+
+DecryptedIOFile::DecryptedIOFile(std::unique_ptr<FileUtil::IOFile>&& underlying_file,
+                                 CryptoRegions regions_)
+    : file(std::move(underlying_file)), regions(std::move(regions_)) {}
+
+DecryptedIOFile::~DecryptedIOFile() = default;
+
+bool DecryptedIOFile::Close() {
+    return file->Close();
+}
+
+u64 DecryptedIOFile::GetSize() const {
+    return file->GetSize();
+}
+
+bool DecryptedIOFile::Resize(u64 size) {
+    UNIMPLEMENTED();
+    return false;
+}
+
+bool DecryptedIOFile::Flush() {
+    return file->Flush();
+}
+
+void DecryptedIOFile::Clear() {
+    file->Clear();
+}
+
+bool DecryptedIOFile::IsCrypto() {
+    return file->IsCrypto();
+}
+
+bool DecryptedIOFile::IsCompressed() {
+    return file->IsCompressed();
+}
+
+const std::string& DecryptedIOFile::Filename() const {
+    return file->Filename();
+}
+
+bool DecryptedIOFile::IsOpen() const {
+    return file->IsOpen();
+}
+
+bool DecryptedIOFile::IsGood() const {
+    return file->IsGood();
+}
+
+int DecryptedIOFile::GetFd() const {
+    return file->GetFd();
+}
+
+bool DecryptedIOFile::Open() {
+    if (is_serializing) {
+        return true;
+    }
+    UNIMPLEMENTED();
+    return false;
+}
+
+void DecryptedIOFile::DecryptCBC(const CryptoRegion& region, u64 offset, u8* data,
+                                 std::size_t length) {
+    // Widen to whole blocks; the block before the first one is its IV.
+    const u64 first = region.begin + (offset - region.begin) / BLOCK_SIZE * BLOCK_SIZE;
+    const u64 wanted_end = offset + length;
+    u64 last = region.begin +
+               (wanted_end - region.begin + BLOCK_SIZE - 1) / BLOCK_SIZE * BLOCK_SIZE;
+    last = std::min(last, region.begin + (region.end - region.begin) / BLOCK_SIZE * BLOCK_SIZE);
+    if (last <= first) {
+        return;
+    }
+
+    const bool has_previous = first != region.begin;
+    const u64 read_from = has_previous ? first - BLOCK_SIZE : first;
+    std::vector<u8> buffer(static_cast<std::size_t>(last - read_from));
+    if (file->ReadAtBytes(buffer.data(), buffer.size(), static_cast<std::size_t>(read_from)) !=
+        buffer.size()) {
+        return;
+    }
+
+    std::array<u8, 16> iv = region.iv;
+    u8* cipher = buffer.data();
+    if (has_previous) {
+        std::memcpy(iv.data(), cipher, BLOCK_SIZE);
+        cipher += BLOCK_SIZE;
+    }
+    const std::size_t cipher_size = static_cast<std::size_t>(last - first);
+    CryptoPP::CBC_Mode<CryptoPP::AES>::Decryption dec(region.key.data(), region.key.size(),
+                                                      iv.data());
+    dec.ProcessData(cipher, cipher, cipher_size);
+
+    const std::size_t skip = static_cast<std::size_t>(offset - first);
+    std::memcpy(data, cipher + skip, std::min(length, cipher_size - skip));
+}
+
+std::size_t DecryptedIOFile::ReadAtImpl(void* data, std::size_t byte_count, std::size_t offset) {
+    const std::size_t read = file->ReadAtBytes(static_cast<u8*>(data), byte_count, offset);
+    if (read == 0 || read == std::numeric_limits<std::size_t>::max()) {
+        return read;
+    }
+
+    const u64 read_begin = offset;
+    const u64 read_end = read_begin + read;
+    for (const auto& region : regions) {
+        const u64 begin = std::max(read_begin, region.begin);
+        const u64 end = std::min(read_end, region.end);
+        if (begin >= end) {
+            continue;
+        }
+        u8* target = static_cast<u8*>(data) + (begin - read_begin);
+        const std::size_t length = static_cast<std::size_t>(end - begin);
+        if (region.mode == CryptoRegion::Mode::CTR) {
+            DecryptCTR(region, begin, target, length);
+        } else {
+            DecryptCBC(region, begin, target, length);
+        }
+    }
+    return read;
+}
+
+std::size_t DecryptedIOFile::ReadImpl(void* data, std::size_t length, std::size_t data_size) {
+    const std::size_t read =
+        ReadAtImpl(data, length * data_size, static_cast<std::size_t>(position));
+    if (read == std::numeric_limits<std::size_t>::max()) {
+        return read;
+    }
+    position += read;
+    return read / data_size;
+}
+
+std::size_t DecryptedIOFile::WriteImpl(const void* data, std::size_t length,
+                                       std::size_t data_size) {
+    UNIMPLEMENTED();
+    return 0;
+}
+
+bool DecryptedIOFile::SeekImpl(s64 off, int origin) {
+    if (is_serializing) {
+        return true;
+    }
+    s64 target;
+    switch (origin) {
+    case SEEK_SET:
+        target = off;
+        break;
+    case SEEK_CUR:
+        target = static_cast<s64>(position) + off;
+        break;
+    case SEEK_END:
+        target = static_cast<s64>(GetSize()) + off;
+        break;
+    default:
+        return false;
+    }
+    if (target < 0) {
+        return false;
+    }
+    position = static_cast<u64>(target);
+    return true;
+}
+
+u64 DecryptedIOFile::TellImpl() const {
+    return position;
+}
+
+template <class Archive>
+void DecryptedIOFile::serialize(Archive& ar, const unsigned int) {
+    is_serializing = true;
+    ar& boost::serialization::base_object<FileUtil::IOFile>(*this);
+    ar & file;
+    ar & regions;
+    ar & position;
+    is_serializing = false;
+}
+
+} // namespace FileSys
+
+SERIALIZE_EXPORT_IMPL(FileSys::DecryptedIOFile)
