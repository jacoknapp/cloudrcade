+// Copyright Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#pragma once
+
+#include <array>
+#include <memory>
+#include <string>
+#include <vector>
+#include <boost/serialization/export.hpp>
+#include "common/common_types.h"
+#include "common/file_util.h"
+
+namespace FileSys {
+
+/// A byte range of a file that is stored encrypted.
+struct CryptoRegion {
+    enum class Mode : u8 {
+        CTR, ///< AES-128-CTR, `iv` is the counter at file offset `origin`
+        CBC, ///< AES-128-CBC, `iv` is the IV of the block at file offset `begin`
+    };
+
+    Mode mode{};
+    u64 begin = 0; ///< First encrypted byte
+    u64 end = 0;   ///< One past the last encrypted byte
+    u64 origin = 0;
+    std::array<u8, 16> key{};
+    std::array<u8, 16> iv{};
+
+private:
+    template <class Archive>
+    void serialize(Archive& ar, const unsigned int) {
+        ar & mode;
+        ar & begin;
+        ar & end;
+        ar & origin;
+        ar & key;
+        ar & iv;
+    }
+    friend class boost::serialization::access;
+};
+
+using CryptoRegions = std::vector<CryptoRegion>;
+
+/// Decrypts `length` bytes in place that were read from file offset `offset` of a CTR region.
+void DecryptCTR(const CryptoRegion& region, u64 offset, u8* data, std::size_t length);
+
+/**
+ * Read-only view of a file in which the given regions appear decrypted. Everything outside of
+ * the regions is passed through untouched, so file offsets are the same as in the wrapped file.
+ */
+class DecryptedIOFile : public FileUtil::IOFile {
+public:
+    DecryptedIOFile();
+    DecryptedIOFile(std::unique_ptr<FileUtil::IOFile>&& underlying_file, CryptoRegions regions);
+    ~DecryptedIOFile() override;
+
+    bool Close() override;
+    u64 GetSize() const override;
+    bool Resize(u64 size) override;
+    bool Flush() override;
+    void Clear() override;
+    bool IsCrypto() override;
+    bool IsCompressed() override;
+    const std::string& Filename() const override;
+    bool IsOpen() const override;
+    bool IsGood() const override;
+    int GetFd() const override;
+
+private:
+    bool Open() override;
+
+    std::size_t ReadImpl(void* data, std::size_t length, std::size_t data_size) override;
+    std::size_t ReadAtImpl(void* data, std::size_t byte_count, std::size_t offset) override;
+    std::size_t WriteImpl(const void* data, std::size_t length, std::size_t data_size) override;
+
+    bool SeekImpl(s64 off, int origin) override;
+    u64 TellImpl() const override;
+
+    void DecryptCBC(const CryptoRegion& region, u64 offset, u8* data, std::size_t length);
+
+    std::unique_ptr<FileUtil::IOFile> file;
+    CryptoRegions regions;
+    u64 position = 0;
+
+    template <class Archive>
+    void serialize(Archive& ar, const unsigned int);
+    friend class boost::serialization::access;
+    bool is_serializing = false;
+};
+
+} // namespace FileSys
+
+BOOST_CLASS_EXPORT_KEY(FileSys::DecryptedIOFile)
