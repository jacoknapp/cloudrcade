diff --git a/src/citra_libretro/citra_libretro.cpp b/src/citra_libretro/citra_libretro.cpp
index a6e342e..bd6cedc 100644
--- a/src/citra_libretro/citra_libretro.cpp
+++ b/src/citra_libretro/citra_libretro.cpp
@@ -968,7 +968,13 @@ static bool DrainAsyncOperations(Core::System& system) {
     auto start = std::chrono::steady_clock::now();
 
     while (system.Kernel().AreAsyncOperationsPending()) {
+#ifdef __EMSCRIPTEN__
+        // This runs the game on the browser's only thread; a page frozen for
+        // seconds gets killed on a phone. The frontend retries instead.
+        if (std::chrono::steady_clock::now() - start > std::chrono::milliseconds(700)) {
+#else
         if (std::chrono::steady_clock::now() - start > std::chrono::seconds(5)) {
+#endif
             LOG_ERROR(Frontend, "Timed out waiting for async operations to complete");
             emu_instance->emu_window->suppressPresentation = false;
             return false;
