+#ifdef __EMSCRIPTEN__
+arm_inst* TranslateWasmArmInstruction(u32 word) {
+    WasmArm::Instruction instruction;
+    if (!WasmArm::Decode(word, instruction))
+        return nullptr;
+    auto* entry = static_cast<arm_inst*>(AllocBuffer(sizeof(arm_inst) + sizeof(instruction)));
+    entry->idx = WasmArm::DispatchIndex;
+    entry->cond = ConditionCode::AL;
+    entry->br = TransExtData::NON_BRANCH;
+    *reinterpret_cast<WasmArm::Instruction*>(entry->component) = instruction;
+    return entry;
+}
+#endif
 
