diff --git a/src/core/arm/dyncom/wasm_arm_ops.h b/src/core/arm/dyncom/wasm_arm_ops.h
new file mode 100644
--- /dev/null
+++ b/src/core/arm/dyncom/wasm_arm_ops.h
@@ -0,0 +1,101 @@
+// Compact decoded forms for common, unconditional ARM instructions in the Wasm interpreter.
+#pragma once
+
+#include <bit>
+#include <cstdint>
+
+namespace WasmArm {
+
+enum class Operation : std::uint8_t { Add, Sub, Compare, Move, LoadWord, LoadByte, StoreWord, StoreByte };
+
+struct Instruction {
+    std::uint32_t immediate;
+    Operation operation;
+    std::uint8_t rd;
+    std::uint8_t rn;
+    std::uint8_t operand;
+};
+
+// An operand below 16 selects a register. A rotated immediate also supplies
+// the shifter carry from bit 31. An unrotated immediate preserves the input carry.
+constexpr std::uint8_t Immediate = 16;
+constexpr std::uint8_t RotatedImmediate = 17;
+constexpr unsigned DispatchIndex = 205;
+
+inline bool Decode(std::uint32_t word, Instruction& out) {
+    if ((word >> 28) != 14)
+        return false;
+
+    const auto rn = static_cast<std::uint8_t>((word >> 16) & 15);
+    const auto rd = static_cast<std::uint8_t>((word >> 12) & 15);
+    if (rn == 15 || rd == 15)
+        return false;
+
+    // Immediate displacement, pre-indexed, without writeback.
+    if ((word & 0x0f200000) == 0x05000000) {
+        const bool load = word & (1u << 20);
+        const bool byte = word & (1u << 22);
+        const auto displacement = word & 0xfff;
+        const Operation op = load ? (byte ? Operation::LoadByte : Operation::LoadWord)
+                                  : (byte ? Operation::StoreByte : Operation::StoreWord);
+        out = {(word & (1u << 23)) ? displacement : 0u - displacement, op, rd, rn, Immediate};
+        return true;
+    }
+
+    if ((word & 0x0c000000) != 0)
+        return false;
+    Operation op;
+    switch ((word >> 20) & 31) { // Four-bit ALU opcode and the S bit.
+    case 4: op = Operation::Sub; break;
+    case 8: op = Operation::Add; break;
+    case 21:
+        if (rd != 0) return false;
+        op = Operation::Compare;
+        break;
+    case 26:
+        if (rn != 0) return false;
+        op = Operation::Move;
+        break;
+    default: return false;
+    }
+
+    if (word & (1u << 25)) {
+        const int rotation = static_cast<int>((word >> 8) & 15) * 2;
+        out = {std::rotr(word & 255u, rotation), op, rd, rn, rotation ? RotatedImmediate : Immediate};
+    } else {
+        const auto rm = static_cast<std::uint8_t>(word & 15);
+        if ((word & 0xff0) || rm == 15) return false;
+        out = {0, op, rd, rn, rm};
+    }
+    return true;
+}
+
+template<class Cpu>
+inline void Execute(Cpu& cpu, const Instruction& inst) {
+    const std::uint32_t lhs = cpu.Reg[inst.rn];
+    switch (inst.operation) {
+    case Operation::LoadWord: cpu.Reg[inst.rd] = cpu.ReadMemory32(lhs + inst.immediate); return;
+    case Operation::LoadByte: cpu.Reg[inst.rd] = cpu.ReadMemory8(lhs + inst.immediate); return;
+    case Operation::StoreWord: cpu.WriteMemory32(lhs + inst.immediate, cpu.Reg[inst.rd]); return;
+    case Operation::StoreByte: cpu.WriteMemory8(lhs + inst.immediate, cpu.Reg[inst.rd]); return;
+    default: break;
+    }
+
+    const std::uint32_t rhs = inst.operand < Immediate ? cpu.Reg[inst.operand] : inst.immediate;
+    cpu.shifter_carry_out = inst.operand == RotatedImmediate ? rhs >> 31 : cpu.CFlag;
+    switch (inst.operation) {
+    case Operation::Add: cpu.Reg[inst.rd] = lhs + rhs; break;
+    case Operation::Sub: cpu.Reg[inst.rd] = lhs - rhs; break;
+    case Operation::Move: cpu.Reg[inst.rd] = rhs; break;
+    case Operation::Compare: {
+        const std::uint32_t result = lhs - rhs;
+        cpu.NFlag = result >> 31;
+        cpu.ZFlag = result == 0;
+        cpu.CFlag = lhs >= rhs;
+        cpu.VFlag = ((lhs ^ rhs) & (lhs ^ result)) >> 31;
+        break;
+    }
+    default: break; // Memory operations returned above.
+    }
+}
+} // namespace WasmArm
