+// A save restores into the same WebGL context. A browser context restoration
+// can retain the JS context object but invalidates every previous GL program.
+EM_JS(unsigned, SharedProgramContext, (), {
+    const gl = Module.ctx;
+    if (!gl || !gl.canvas || gl.isContextLost()) return 0;
+    if (Module.wrcSharedProgramGL !== gl) {
+        Module.wrcSharedProgramGL = gl;
+        Module.wrcSharedProgramGeneration = (Module.wrcSharedProgramGeneration || 0) + 1;
+        gl.canvas.addEventListener('webglcontextlost', function() {
+            if (Module.wrcSharedProgramGL === gl) Module.wrcSharedProgramGL = null;
+        }, {once: true});
+    }
+    return Module.wrcSharedProgramGeneration;
+});
