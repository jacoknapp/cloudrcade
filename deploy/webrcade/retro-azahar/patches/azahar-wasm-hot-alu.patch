+// Wasm's f64 result is exact for a product of two f32 significands or
+// for an aligned sum that fits within 53 bits. Keep edge cases and other
+// rounding modes in the original VFP path.
+static bool wasm_vfp_exact_scalar(u32 op, u32 n, u32 m, u32& bits, u32& exceptions) {
+    const auto n_exponent = (n >> 23) & 255u;
+    const auto m_exponent = (m >> 23) & 255u;
+    if (!n_exponent || !m_exponent || n_exponent == 255 || m_exponent == 255)
+        return false;
+
+    const double left = std::bit_cast<float>(n);
+    const double right = std::bit_cast<float>(m);
+    double result;
+    if (op == FOP_FMUL) {
+        result = left * right;
+    } else {
+        if (n_exponent > m_exponent + 29 || m_exponent > n_exponent + 29)
+            return false;
+        result = op == FOP_FSUB ? left - right : left + right;
+    }
+    const float rounded = static_cast<float>(result);
+    const u32 word = std::bit_cast<u32>(rounded);
+    const u32 exponent = (word >> 23) & 255u;
+    if (exponent < 2 || exponent > 253)
+        return false;
+    bits = word;
+    exceptions = result == rounded ? 0 : FPSCR_IXC;
+    return true;
+}
