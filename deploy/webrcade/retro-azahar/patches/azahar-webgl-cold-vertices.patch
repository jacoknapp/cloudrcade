new file mode 100644
index 0000000..8dda057
--- /dev/null
+++ b/src/video_core/renderer_opengl/wasm_cold_vertices.h
@@ -0,0 +1,37 @@
+// Copyright CloudRcade contributors
+// Licensed under GPLv2 or any later version.
+
+#pragma once
+
+#include <cstdint>
+#include <string_view>
+
+namespace OpenGL {
+
+class WasmColdVertices {
+public:
+    static constexpr std::uint32_t MaxDraw = 64;
+
+    // Both loop forms come from the PICA decompiler: guest LOOP and general
+    // jumps. Their runtime cost cannot be bounded by the generated code size.
+    static bool EligibleShader(std::string_view code) {
+        return code.size() >= 16 * 1024 && code.size() <= 48 * 1024 &&
+               code.find("for (") == code.npos && code.find("while (") == code.npos;
+    }
+
+    void BeginFrame() { frame_vertices = 0; }
+
+    bool Spend(std::uint32_t count, std::uint32_t& shader_vertices) {
+        if (!count || count > MaxDraw || shader_vertices > 8192 - count ||
+            frame_vertices > 768 - count)
+            return false;
+        shader_vertices += count;
+        frame_vertices += count;
+        return true;
+    }
+
+private:
+    std::uint32_t frame_vertices = 0;
+};
+
+} // namespace OpenGL
