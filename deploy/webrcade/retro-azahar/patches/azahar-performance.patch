diff --git a/src/core/arm/dyncom/wasm_translation_cache.h b/src/core/arm/dyncom/wasm_translation_cache.h
new file mode 100644
index 0000000..9ca8e99
--- /dev/null
+++ b/src/core/arm/dyncom/wasm_translation_cache.h
@@ -0,0 +1,43 @@
+// Shared decoded-block cache for the single-threaded WASM CPU scheduler.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <unordered_map>
+
+namespace Memory {
+struct PageTable;
+}
+
+class WasmTranslationCache {
+public:
+    WasmTranslationCache(std::size_t& arena_top_, std::size_t capacity_)
+        : arena_top(arena_top_), capacity(capacity_) {}
+
+    void Reset() {
+        blocks.clear();
+        arena_top = 0;
+    }
+
+    void SelectPageTable(const std::shared_ptr<Memory::PageTable>& page_table) {
+        if (resident_page_table.lock() != page_table) {
+            Reset();
+            resident_page_table = page_table;
+        }
+    }
+
+    void ReserveBlock(std::size_t reserve) {
+        if (reserve > capacity || arena_top > capacity - reserve) {
+            Reset();
+        }
+    }
+
+    std::unordered_map<std::uint32_t, std::size_t>& Blocks() { return blocks; }
+
+private:
+    std::size_t& arena_top;
+    const std::size_t capacity;
+    std::weak_ptr<Memory::PageTable> resident_page_table;
+    std::unordered_map<std::uint32_t, std::size_t> blocks;
+};
