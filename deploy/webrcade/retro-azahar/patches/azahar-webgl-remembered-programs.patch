 #if defined(__EMSCRIPTEN__)
+namespace RememberedPrograms {
+namespace {
+// Written by the core, kept across sessions by the frontend (IndexedDB).
+constexpr char FILE_PATH[] = "/home/web_user/retroarch/userdata/shadercache/programs.bin";
+// The GLSL depends on this build's generators: never reuse another build's file.
+constexpr char STAMP[] = "WRCP1 " __DATE__ " " __TIME__;
+
+struct Source {
+    GLenum type;
+    std::string text;
+};
+struct Record {
+    u64 id, vertex, fragment;
+};
+struct State {
+    std::FILE* file = nullptr;
+    std::unordered_map<u64, Source> sources;   ///< from the file, not compiled yet
+    std::unordered_map<u64, GLuint> compiled;  ///< shaders rebuilt from the file
+    std::unordered_map<GLuint, u64> hashes;    ///< shaders the game compiled this session
+    std::unordered_set<u64> shaders_on_file;
+    std::unordered_set<u64> programs_on_file;
+    std::vector<Record> records;
+};
+
+template <typename T>
+bool Read(std::FILE* file, T& value) {
+    return std::fread(&value, sizeof(T), 1, file) == 1;
+}
+template <typename T>
+void Write(std::FILE* file, const T& value) {
+    std::fwrite(&value, sizeof(T), 1, file);
+}
+
+State& Get() {
+    static State state;
+    static bool opened = false;
+    if (opened) {
+        return state;
+    }
+    opened = true;
+    bool valid = false;
+    if (std::FILE* file = std::fopen(FILE_PATH, "rb")) {
+        char stamp[sizeof(STAMP)]{};
+        valid = std::fread(stamp, sizeof(stamp), 1, file) == 1 &&
+                std::memcmp(stamp, STAMP, sizeof(STAMP)) == 0;
+        for (u8 kind; valid && Read(file, kind);) {
+            if (kind == 'S') {
+                u64 hash;
+                u32 type, length;
+                if (!Read(file, hash) || !Read(file, type) || !Read(file, length) ||
+                    length > 4 * 1024 * 1024) {
+                    break;
+                }
+                std::string text(length, '\0');
+                if (std::fread(text.data(), 1, length, file) != length) {
+                    break;
+                }
+                state.sources[hash] = Source{static_cast<GLenum>(type), std::move(text)};
+                state.shaders_on_file.insert(hash);
+            } else if (kind == 'P') {
+                Record record;
+                if (!Read(file, record.id) || !Read(file, record.vertex) ||
+                    !Read(file, record.fragment)) {
+                    break;
+                }
+                if (state.programs_on_file.insert(record.id).second) {
+                    state.records.push_back(record);
+                }
+            } else {
+                break;
+            }
+        }
+        std::fclose(file);
+    }
+    // A file from another build, or none: start a new one. Otherwise add to it.
+    state.file = std::fopen(FILE_PATH, valid ? "ab" : "wb");
+    if (state.file && !valid) {
+        std::fwrite(STAMP, sizeof(STAMP), 1, state.file);
+        std::fflush(state.file);
+    }
+    EM_ASM({ (Module.wrcShaders || (Module.wrcShaders = {built: 0, skipped: 0, waited: 0}))
+                 .remembered = $0; }, static_cast<int>(state.records.size()));
+    return state;
+}
+
+GLuint Rebuild(State& state, u64 hash) {
+    if (const auto it = state.compiled.find(hash); it != state.compiled.end()) {
+        return it->second;
+    }
+    const auto it = state.sources.find(hash);
+    if (it == state.sources.end()) {
+        return 0;
+    }
+    const GLuint shader = glCreateShader(it->second.type);
+    const GLchar* text = it->second.text.data();
+    const GLint length = static_cast<GLint>(it->second.text.size());
+    glShaderSource(shader, 1, &text, &length);
+    glCompileShader(shader); // not waited for: the link reports a failure
+    state.compiled.emplace(hash, shader);
+    state.sources.erase(it);
+    return shader;
+}
+} // namespace
+
+void NoteShader(GLuint shader, GLenum type, std::string_view preamble, std::string_view source) {
+    State& state = Get();
+    std::string text{preamble};
+    text += source;
+    const u64 hash = Common::ComputeHash64(text.data(), text.size());
+    state.hashes[shader] = hash;
+    if (!state.file || !state.shaders_on_file.insert(hash).second) {
+        return;
+    }
+    // Kept as well: the game's own shader objects go when a save state is
+    // loaded, and the programs are then rebuilt from this text.
+    state.sources[hash] = Source{type, text};
+    Write(state.file, u8{'S'});
+    Write(state.file, hash);
+    Write(state.file, static_cast<u32>(type));
+    Write(state.file, static_cast<u32>(text.size()));
+    std::fwrite(text.data(), 1, text.size(), state.file);
+    std::fflush(state.file);
+}
+
+void NoteProgram(u64 id, GLuint vertex, GLuint fragment) {
+    State& state = Get();
+    const auto vs = state.hashes.find(vertex);
+    const auto fs = state.hashes.find(fragment);
+    if (!state.file || vs == state.hashes.end() || fs == state.hashes.end() ||
+        !state.programs_on_file.insert(id).second) {
+        return;
+    }
+    Write(state.file, u8{'P'});
+    Write(state.file, id);
+    Write(state.file, vs->second);
+    Write(state.file, fs->second);
+    std::fflush(state.file);
+    state.records.push_back(Record{id, vs->second, fs->second});
+}
+
+bool At(std::size_t index, Entry& entry) {
+    State& state = Get();
+    if (index >= state.records.size()) {
+        return false;
+    }
+    const Record record = state.records[index];
+    entry = Entry{record.id, Rebuild(state, record.vertex), Rebuild(state, record.fragment)};
+    if (entry.fragment == 0) {
+        entry.vertex = 0;
+    }
+    return true;
+}
+} // namespace RememberedPrograms
