+void ShaderProgramManager::RebuildRemembered() {
+#if defined(__EMSCRIPTEN__)
+    if (impl->separable || !ProgramsLinkInBackground()) {
+        return;
+    }
+    // Some per frame: the browser builds them on its own threads while the
+    // game runs, in the order they were first needed.
+    RememberedPrograms::Entry entry;
+    for (int count = 0; count < 8 && RememberedPrograms::At(remembered_done, entry);) {
+        ++remembered_done;
+        if (entry.vertex == 0) {
+            continue;
+        }
+        GLuint& program = background_programs[entry.id];
+        if (program != 0) {
+            continue;
+        }
+        ++count;
+        program = BeginProgram(std::array{entry.vertex, GLuint{0}, entry.fragment});
+        linking.emplace(program, -1.0);
+        EM_ASM({ Module.wrcShaders.rebuilt = (Module.wrcShaders.rebuilt || 0) + 1; });
+    }
+#endif
+}
