+/// A record of the programs a game has used, kept in a file the web frontend
+/// stores between sessions: the GLSL of every shader and which pairs were
+/// linked. At() hands them back in the order they were first used, so that
+/// they can be rebuilt in the background before the game asks for them again.
+/// The list is kept: loading a save state starts a new shader manager, which
+/// goes through it once more.
+namespace RememberedPrograms {
+struct Entry {
+    u64 id;
+    GLuint vertex;
+    GLuint fragment;
+};
+void NoteShader(GLuint shader, GLenum type, std::string_view preamble, std::string_view source);
+void NoteProgram(u64 id, GLuint vertex, GLuint fragment);
+/// False past the end of the list. `entry.vertex` is 0 for a record that cannot be rebuilt.
+bool At(std::size_t index, Entry& entry);
+} // namespace RememberedPrograms
