diff --git a/emscripten/library_rwebaudio.js b/emscripten/library_rwebaudio.js
index d97bfea..f6fe32e 100644
--- a/emscripten/library_rwebaudio.js
+++ b/emscripten/library_rwebaudio.js
@@ -28,7 +28,14 @@ var LibraryRWebAudio = {
    },
 
    RWebAudioResumeCtx: function() {
-      if (!RWA.contextRunning) RWA.context.resume();
+      // A phone may require a fresh user gesture. Keep only one resume pending
+      // and handle denial rather than rejecting a Promise on every audio frame.
+      if (!RWA.contextRunning && !RWA.resumePending) {
+         RWA.resumePending = true;
+         RWA.context.resume().catch(function() {}).finally(function() {
+            RWA.resumePending = false;
+         });
+      }
       return RWA.contextRunning;
    },
 
@@ -37,7 +44,7 @@ var LibraryRWebAudio = {
       var ac = window.AudioContext || window.webkitAudioContext;
       if (!ac) return 0;
 
-      RWA.context = new ac();
+      RWA.context = window.readyAudioContext || new ac();
       RWA.currentTimeDiff = performance.now() / 1000 - RWA.context.currentTime;
       RWA.nonblock = false;
       RWA.endTime = 0;
diff --git a/emulatorjs/build-emulatorjs.sh b/emulatorjs/build-emulatorjs.sh
index 376d098..d81c35f 100755
--- a/emulatorjs/build-emulatorjs.sh
+++ b/emulatorjs/build-emulatorjs.sh
@@ -74,6 +74,7 @@ needsAsync=("mupen64plus_next" "dosbox_pure" "ppsspp" "azahar" "bsnes" "bluemsx"
 for f in $(ls -v *_emscripten.bc); do
   name=`echo "$f" | sed "s/\(_libretro_emscripten\|\).bc$//"`
   async=0
+  min_async=0
   sevenZip=1
   wasm=1
   gles3=1
@@ -125,6 +126,18 @@ for f in $(ls -v *_emscripten.bc); do
     exit 1
   fi
 
+  # Keep startup resources bounded for Safari/iPhone. Extra pthreads can grow
+  # on demand, but do not instantiate 32 WASM workers just to open a game.
+  if [ "$name" = "azahar" ]; then
+    stack_mem=8388608 # 8 MiB main stack
+    heap_mem=268435456 # 256 MiB initial memory; grows as needed
+    pthread=4
+    # The core never suspends through indirect callbacks. Audio yields at the
+    # frontend loop instead, avoiding full Asyncify in the hot CPU/shader paths.
+    async=0
+    min_async=1
+  fi
+
   echo "-- Building core: $name --"
   cp -f "$f" ../libretro_emscripten.a
    
