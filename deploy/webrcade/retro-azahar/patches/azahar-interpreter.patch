--- a/src/core/arm/dyncom/wasm_translation_cache.h
+++ b/src/core/arm/dyncom/wasm_translation_cache.h
@@ -1,6 +1,7 @@
 // Shared decoded-block cache for the single-threaded WASM CPU scheduler.
 #pragma once
 
+#include <array>
 #include <cstddef>
 #include <cstdint>
 #include <memory>
@@ -17,6 +18,7 @@
 
     void Reset() {
         blocks.clear();
+        recent.fill({});
         arena_top = 0;
     }
 
@@ -34,19 +36,37 @@
     }
 
     bool Find(std::uint32_t key, std::size_t& offset) {
+        auto& slot = RecentSlot(key);
+        if (slot.offset_plus_one && slot.key == key) {
+            offset = slot.offset_plus_one - 1;
+            return true;
+        }
         const auto it = blocks.find(key);
         if (it == blocks.end()) return false;
         offset = it->second;
+        slot = {key, offset + 1};
         return true;
     }
 
     void Store(std::uint32_t key, std::size_t offset) {
         blocks[key] = offset;
+        RecentSlot(key) = {key, offset + 1};
     }
 
     const tsl::robin_pg_map<std::uint32_t, std::size_t>& Blocks() const { return blocks; }
 
 private:
+    // Colliding addresses or execution modes always fall back to the complete map.
+    struct Entry {
+        std::uint32_t key;
+        std::size_t offset_plus_one; // Offset plus one so zero represents an empty slot.
+    };
+
+    Entry& RecentSlot(std::uint32_t key) {
+        return recent[(key >> 1) & (recent.size() - 1)];
+    }
+
+    std::array<Entry, 4096> recent{};
     std::size_t& arena_top;
     const std::size_t capacity;
     std::weak_ptr<Memory::PageTable> resident_page_table;
