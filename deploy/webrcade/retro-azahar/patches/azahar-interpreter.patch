+#ifdef __EMSCRIPTEN__
+// Give Wasm direct calls for the common operands. The existing handlers retain
+// the carry and PC semantics, including the pipelined PC value in ARM/Thumb.
+static inline u32 GetWasmShifterOperand(ARMul_State* cpu, shtop_fp_t shift, u32 operand) {
+    if (shift == DPO(Immediate))
+        return DPO(Immediate)(cpu, operand);
+    if (shift == DPO(Register))
+        return DPO(Register)(cpu, operand);
+    return shift(cpu, operand);
+}
+
+static inline void GetWasmTransferAddress(ARMul_State* cpu, const ldst_inst* transfer,
+                                          unsigned int& addr) {
+    if (transfer->get_addr == LnSWoUB(ImmediateOffset))
+        LnSWoUB(ImmediateOffset)(cpu, transfer->inst, addr);
+    else
+        transfer->get_addr(cpu, transfer->inst, addr);
+}
+#endif
