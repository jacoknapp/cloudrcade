diff --git a/src/core/CMakeLists.txt b/src/core/CMakeLists.txt
--- a/src/core/CMakeLists.txt
+++ b/src/core/CMakeLists.txt
@@ -536,3 +536,10 @@
 if (CITRA_USE_PRECOMPILED_HEADERS)
     target_precompile_headers(citra_core PRIVATE precompiled_headers.h)
 endif()
+
+# The WASM link mixes LLVM bitcode and native objects. Keep the virtual save
+# directory callbacks at their declared ABI instead of ThinLTO argument promotion.
+if (EMSCRIPTEN)
+    set_source_files_properties(file_sys/savedata_archive.cpp
+        PROPERTIES COMPILE_OPTIONS "-fno-lto")
+endif()
diff --git a/src/citra_libretro/environment.cpp b/src/citra_libretro/environment.cpp
--- a/src/citra_libretro/environment.cpp
+++ b/src/citra_libretro/environment.cpp
@@ -274,8 +274,18 @@
     auto geom = ComputeLayoutGeometry();
     info->geometry.base_width = geom.width;
     info->geometry.base_height = geom.height;
-    // Max must cover the largest possible layout (SideScreen at 10x = 7200).
+#ifdef __EMSCRIPTEN__
+    // Reserving the desktop 10x maximum makes RetroArch round up to an
+    // 8192x8192 framebuffer and allocate two 256 MiB readback buffers.
+    // The web app uses native resolution; cover every native layout plus the
+    // currently requested geometry without allocating for unused 10x modes.
+    info->geometry.max_width = std::max<unsigned>(geom.width,
+        Core::kScreenBottomWidth + Core::kScreenTopWidth);
+    info->geometry.max_height = std::max<unsigned>(geom.height,
+        Core::kScreenTopHeight + Core::kScreenBottomHeight);
+#else
     info->geometry.max_width = (Core::kScreenBottomWidth + Core::kScreenTopWidth) * 10;
     info->geometry.max_height = (Core::kScreenTopHeight + Core::kScreenBottomHeight) * 10;
+#endif
     info->geometry.aspect_ratio = (float)geom.width / (float)geom.height;
 }
