diff --git a/src/video_core/renderer_opengl/wasm_prewarm_budget.h b/src/video_core/renderer_opengl/wasm_prewarm_budget.h
new file mode 100644
--- /dev/null
+++ b/src/video_core/renderer_opengl/wasm_prewarm_budget.h
@@ -0,0 +1,29 @@
+// Bound speculative compiler work; demand draws always retain their completion wait.
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <vector>
+
+template <typename Handle>
+class WasmPrewarmBudget {
+public:
+    template <typename Ready>
+    bool BeginFrame(Ready ready) {
+        std::erase_if(pending, ready);
+        submitted = 0;
+        if (quiet_frames != 0) {
+            --quiet_frames;
+            return false;
+        }
+        return true;
+    }
+    bool Available() const { return pending.size() < 8 && submitted < 2; }
+    void Submit(Handle handle) { pending.push_back(handle); ++submitted; }
+    void Consume(Handle handle) { std::erase(pending, handle); }
+    void DemandWait() { quiet_frames = 2; }
+    std::size_t Pending() const { return pending.size(); }
+private:
+    std::vector<Handle> pending;
+    unsigned submitted = 0;
+    unsigned quiet_frames = 0;
+};
