+#if defined(__EMSCRIPTEN__)
+std::optional<GLuint> RasterizerOpenGL::PrepareResidentVertexInput(u8* output, u32 size,
+                                                                   u32 vertex_min, u32 vertex_max) {
+    constexpr std::size_t MaxBytes = 4_MiB;
+    constexpr std::size_t MaxEntries = 256;
+    if (size < 256 || size > 256_KiB) {
+        return std::nullopt;
+    }
+
+    const auto& attributes = regs.pipeline.vertex_attributes;
+    const auto base = attributes.GetPhysicalBaseAddress();
+    const u32 vertex_count = vertex_max - vertex_min + 1;
+    struct Range {
+        PAddr address;
+        u32 size;
+    };
+    std::array<Range, 12> ranges{};
+    std::size_t num_ranges = 0;
+    std::size_t bytes = 0;
+    for (const auto& loader : attributes.attribute_loaders) {
+        if (loader.component_count == 0 || loader.byte_count == 0) {
+            continue;
+        }
+        const u64 length = static_cast<u64>(loader.byte_count) * vertex_count;
+        if (length > size - bytes || num_ranges == ranges.size()) {
+            return std::nullopt;
+        }
+        ranges[num_ranges++] = {
+            base + loader.data_offset + vertex_min * loader.byte_count, static_cast<u32>(length)};
+        bytes += length;
+    }
+    // The original path leaves unused alignment bytes in the stream buffer.
+    // Only cache draws whose upload is completely described by these ranges.
+    if (bytes != size) {
+        return std::nullopt;
+    }
+
+    const u8* input = output;
+    if (num_ranges == 1) {
+        const auto& range = ranges[0];
+        res_cache.FlushRegion(range.address, range.size);
+        input = memory.GetPhysicalPointer(range.address);
+    } else {
+        auto* dest = output;
+        for (std::size_t i = 0; i < num_ranges; ++i) {
+            const auto& range = ranges[i];
+            res_cache.FlushRegion(range.address, range.size);
+            std::memcpy(dest, memory.GetPhysicalPointer(range.address), range.size);
+            dest += range.size;
+        }
+    }
+
+    // Sampled bytes are only an index. A hit always verifies the full upload.
+    u64 key = size;
+    for (u32 i = 0; i < 16; ++i) {
+        key = (key ^ input[(size - 1) * i / 15]) * 1099511628211ull;
+    }
+    const auto item = resident_vertex_inputs.find(key);
+    if (item != resident_vertex_inputs.end()) {
+        const auto& entry = item->second;
+        if (entry.bytes.size() == size && std::memcmp(entry.bytes.data(), input, size) == 0) {
+            return entry.buffer.handle;
+        }
+    }
+    if (input != output) {
+        std::memcpy(output, input, size);
+    }
+    if (item != resident_vertex_inputs.end() || resident_vertex_inputs.size() >= MaxEntries ||
+        resident_vertex_bytes + size > MaxBytes) {
+        return 0;
+    }
+
+    ResidentVertexInput entry;
+    entry.buffer.Create();
+    if (!entry.buffer.handle) {
+        return 0;
+    }
+    entry.bytes.assign(output, output + size);
+    const GLuint handle = entry.buffer.handle;
+    state.draw.vertex_buffer = handle;
+    state.Apply();
+    glBufferData(GL_ARRAY_BUFFER, size, output, GL_STATIC_DRAW);
+    resident_vertex_bytes += size;
+    resident_vertex_inputs.emplace(key, std::move(entry));
+    return handle;
+}
+#endif
