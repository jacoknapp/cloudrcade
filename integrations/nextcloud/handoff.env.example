# For direct Docker env_file use, or RETROARCADE_ENV_FILE for the installer.
NEXTCLOUD_CONTAINER=nextcloud
NEXTCLOUD_APP_PATH=/var/www/html/custom_apps
NEXTCLOUD_OCC_PATH=/var/www/html/occ
# Empty uses Nextcloud's own absolute base URL.
RETROARCADE_SERVER_URL=
# Empty uses the normal Nextcloud login; select your installed SAML provider to reuse SSO.
RETROARCADE_LEGACY_ORIGIN=
RETROARCADE_SAML_IDP=
# Exact origins, client names and callbacks; empty denies automatic authorization.
RETROARCADE_TRUSTED_CLIENTS='{"https://arcade.example.com":{"client":"CloudRcade cloud saves","name":"CloudRcade","callback":"https://arcade.example.com/cloud-saves/?resume=1","back":"https://arcade.example.com/cloud-saves/"}}'
