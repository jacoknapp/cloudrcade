# Docker paths and listening address. Place this behind your HTTPS proxy.
WEBRCADE_HOST_PATH=./data
WEBRCADE_ROM_PATH=./roms
WEBRCADE_MANAGED_PATH=./managed
WEBRCADE_BIND_ADDRESS=127.0.0.1
WEBRCADE_HTTPS_PORT=8443
WEBRCADE_PUBLIC_URL=https://arcade.example.com
# Relative URLs use the deployment's own origin.
WEBRCADE_FEED_URL=/content/feeds/combined.json
WEBRCADE_CONTENT_URL=/content/
WEBRCADE_APP_NAME=cloudЯcade
WEBRCADE_FEED_TITLE=cloudЯcade
WEBRCADE_FEED_DESCRIPTION='Games from your ROM library.'
WEBRCADE_STORAGE_PREFIX=cloudrcade
# Key-free 3DS app is included; encrypted games need your runtime BIOS keys.
WEBRCADE_ENABLE_3DS=true
# Your own key set, read only at runtime; never put key contents in env.
WEBRCADE_3DS_BIOS_PATH=./roms/3DS/bios
WEBRCADE_3DS_KEYS_FILE=/run/cloudrcade/3ds/aes_keys.txt
NEXTCLOUD_SAVE_FOLDER=CloudRcade
# Optional existing handoff client name, independent of display branding.
NEXTCLOUD_CLIENT_NAME=
NEXTCLOUD_URL=
NEXTCLOUD_ENABLED=false
NEXTCLOUD_AUTO_REDIRECT=false
NEXTCLOUD_HANDOFF=false
NEXTCLOUD_ACCESS_HEADER=
NEXTCLOUD_ACCESS_VALUE=
NEXTCLOUD_LEGACY_URL=
# Dropbox scoped App Folder app; public app key only (PKCE, no app secret).
DROPBOX_ENABLED=false
DROPBOX_APP_KEY=
DROPBOX_SAVE_FOLDER=CloudRcade
# Paths used by the scanner inside this container.
WEBRCADE_ROM_ROOT=/var/www/html/content
WEBRCADE_STATE_PATH=/data
WEBRCADE_MANAGED_ROOT=/var/www/html/managed
WEBRCADE_REQUIRE_ROM_MOUNT=false
WEBRCADE_REQUIRED_ROM_DIR=
WEBRCADE_METADATA_ENABLED=false
WEBRCADE_METADATA_CONFIG=
WEBRCADE_METADATA_CONTAINER=
WEBRCADE_METADATA_PATH_PREFIX=
WEBRCADE_3DS_SKIP_DIRS=
WEBRCADE_3DS_SKIP_NAMES=

# Integrated feed scanner: run at startup and refresh every six hours.
WEBRCADE_SCAN_ENABLED=true
WEBRCADE_SCAN_INTERVAL_SECONDS=21600

# Optional Gaseous metadata: runtime JSON with DatabaseConfiguration credentials.
WEBRCADE_CONFIG_PATH=./config
WEBRCADE_METADATA_DB_HOST=
WEBRCADE_METADATA_DB_PORT=3306

# Optional shared MariaDB Unix socket; takes precedence over the TCP host.
WEBRCADE_METADATA_DB_SOCKET=
